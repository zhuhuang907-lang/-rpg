+with open('C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/meta13.json', 'w', encoding='utf8', newline='\n') as f:
+    json.dump(meta_out, f, ensure_ascii=False, indent=1)
