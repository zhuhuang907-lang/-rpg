+md += '\n合计：' + rows.length + ' 回、检出 ' + tot + ' 条（' + (tot / Math.max(1, rows.length)).toFixed(1) + ' 条/回），其中硬伤 ' + hardTot + ' 条、待复核 ' + (tot - hardTot) + ' 条\n';
+fs.writeFileSync(MD, md, 'utf8');
