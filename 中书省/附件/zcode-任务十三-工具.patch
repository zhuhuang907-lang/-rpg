+  'wengu': '节度使掌书记→监察御史里行→新镇掌书记→司户参军→殿中侍御史（文资幕职线）',
+}
+rows = []
+meta_out = {}
+for d in sorted(glob.glob(OUT + '/*')):
+    k = os.path.basename(d)
+    if k == 'calls' or not os.path.isdir(d):
+        continue
+    turns = []
+    op = {}
+    try:
+        with open(d + '/00-opening.json', encoding='utf8') as f:
