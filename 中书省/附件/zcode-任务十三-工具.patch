+                   '开局ms': op.get('ms'), '开局ok': op.get('ok'), '回数': len(turns), '成功回数': okn, '用时合计ms': ms,
+                   '拦下回数': blocked, '抖动回数': retried, '在局受阻回数': story, 'turns': turns, 'reload': rl, 'excerpts': exc}
