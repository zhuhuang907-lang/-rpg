+        ok = v.get('ok')
+        ms += (v.get('ms') or 0)
+        if ok:
+            okn += 1
+        rows.append({'s': k, 'i': v.get('i'), 'y': v.get('y'), 'pol': v.get('pol'), 'text': v.get('text') or ''})
+        turns.append({'i': v.get('i'), 'ok': ok, 'ms': v.get('ms'), 'y': v.get('y'), 'm': v.get('m'), 'when': v.get('yearLabel'), 'pol': v.get('pol'),
+                      'said': (v.get('said') or '')[:60], 'tlen': len(v.get('text') or ''),
+                      'err': v.get('err') or '', 'receipt': (v.get('receipt') or '')[:200],
