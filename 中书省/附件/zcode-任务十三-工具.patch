+# 任务十三：把 out13/ 的每套实玩写成「中书省/附件/实玩/2026-11-21-<打法>.md」一页记录。
+# 用法：python -I make_records.py
+import json, glob, os, datetime
+
+OUT = 'C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/out13'
+REC = 'C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/records'
+META = 'C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/meta13.json'
+DUI = 'C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/对表.json'
+DATE = '2026-11-21'
+TITLE = {
+  'chu': '楚国牙军小卒→楚王（通关打法）',
+  'huofa1': '绸缎商人→军吏→粮料判官→孔目官→镇遏使→里正（活法转换 5 次）',
+  'huofa2': '沙弥→伙兵→十将→亲随将→马步军都虞候→县令（活法转换 4 次）',
+  'huofa3': '银匠→金银铺主→田庄地主→乡长/司户佐史（活法转换 4 次）',
+  'chuwar': '楚国马步军都指挥使的战争操控（野战、夜袭、守城、追击、受降、整军、御边）',
+  'wild1': '乱来之一：火铳、报馆、银票、电报、铁路、洋操新军、玻璃镜、蒸汽机、飞鸢、印刷机、专利',
+  'wild2': '乱来之二：寻仙、辟谷、炼丹、画符、禳灾、星变奏对、剑仙、隐身、越狱',
+  'wengu': '节度使掌书记→监察御史里行→新镇掌书记→司户参军→殿中侍御史（文资幕职线）',
+}
+COST = [0.02, 1, 4]   # 快型号每百万 token：缓存命中、未命中、输出（元）
+
+
+def peak(t0):
+    try:
+        d = datetime.datetime.fromisoformat(t0.replace('Z', '+00:00')) + datetime.timedelta(hours=8)
+    except Exception:
+        return 1
+    return 2 if d.weekday() < 5 and ((9 <= d.hour < 12) or (14 <= d.hour < 18)) else 1
+
+
+def costs():
+    """每套花费：优先读该套存档里的花费账 costLog（游戏自己照官方价目记的，最准）；读不到再看调用记录。"""
+    per = {}
+    for k in TITLE:
+        sid = ''
+        try:
+            with open(OUT + '/' + k + '/00-sid.txt', encoding='utf8') as f:
+                sid = f.read().strip()
+        except OSError:
+            sid = ''
+        if not sid:
+            continue
+        try:
+            with open('C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/scan-rpg/rpg-kernel/data/websaves/' + sid + '.json', encoding='utf8') as f:
+                d = json.load(f)
+        except (OSError, ValueError):
+            continue
+        cl = d.get('costLog') or []
+        if cl:
+            per[k] = {'yuan': sum(float(x.get('yuan') or 0) for x in cl), 'calls': len(cl),
+                      'inn': sum(int(x.get('in') or 0) for x in cl), 'out': sum(int(x.get('out') or 0) for x in cl)}
+    files = sorted(glob.glob(OUT + '/calls/*.json'))
+    for f in files:
+        try:
+            with open(f, encoding='utf8') as fh:
+                d = json.load(fh)
+        except (OSError, ValueError):
+            continue
+        u = d.get('usage') or {}
+        if not u:
+            continue
+        who = str(d.get('phase') or '').split(':')[0]
+        if who not in TITLE or who in per:
+            continue
+        inn, hit, out = int(u.get('in') or 0), int(u.get('cacheHit') or 0), int(u.get('out') or 0)
+        miss = max(0, inn - hit)
+        yuan = (miss * COST[1] + hit * COST[0] + out * COST[2]) / 1e6 * peak(d.get('t0') or '')
+        o = per.setdefault(who, {'yuan': 0.0, 'calls': 0, 'inn': 0, 'out': 0})
+        o['yuan'] += yuan
+        o['calls'] += 1
+        o['inn'] += inn
+        o['out'] += out
+    return per
+
+
+def main():
+    os.makedirs(REC, exist_ok=True)
+    with open(META, encoding='utf8') as f:
+        meta = json.load(f)
+    try:
+        with open(DUI, encoding='utf8') as f:
