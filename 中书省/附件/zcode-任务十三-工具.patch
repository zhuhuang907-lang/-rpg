+const r = findings(bad930.text, bad930.y);
+const kinds = k => r.filter(x => x.kind === k).map(x => x.text);
+console.log('检出：', JSON.stringify(r.map(x => x.kind + ':' + x.text)));
+let fail = 0;
+const must = [
+  ['人名', ['王思远', '林昭德']],
+  ['官名', ['知府', '总督', '知县']],
+  ['年号', ['天成十四年']],
+  ['词物/官名', ['电报', '火枪', '铅笔', '钢笔']],
