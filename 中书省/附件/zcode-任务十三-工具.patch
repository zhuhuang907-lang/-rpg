+    cb = costs()
+    summary = ['# 任务十三 · 真模型实玩八套总表（' + DATE + '）', '',
+               '| 打法 | 回数 | 对不上（条/每回） | 拦下 | 用时合计 | 花费合计 | 每回均费 |', '|---|---|---|---|---|---|---|']
+    for k in ['chu', 'huofa1', 'huofa2', 'huofa3', 'chuwar', 'wild1', 'wild2', 'wengu']:
+        m = meta.get(k) or {}
+        turns = m.get('turns') or []
+        n = len(turns)
+        if not n:
+            continue
+        okn = m.get('成功回数') or 0
+        nf = (dui.get(k) or {}).get('findings', 0)
+        ms = sum((t.get('ms') or 0) for t in turns)
+        c = cb.get(k) or {'yuan': 0, 'inn': 0, 'out': 0, 'calls': 0}
+        avg = c['yuan'] / max(1, okn)
+        lines = ['# 实玩记录 · ' + k, '',
+                 '- 日期：' + DATE,
+                 '- 打法：' + (TITLE.get(k) or m.get('说明') or ''),
+                 '- 开局：' + ('；'.join(str(x) for x in (m.get('form') or []) if x) if m.get('form') else '见 00-opening.json'),
+                 '- 回数：%d/%d（完成 %d）' % (okn, n, n),
+                 '- 对不上：%d 条，%.1f 条/回（明细见 对表.md 的 %s 节）' % (nf, nf / max(1, n), k),
+                 '- 引擎拦下（程序打回玩家的话，应为零）：%d 次' % (m.get('拦下回数') or 0),
+                 '- 网络抖动自动重试：%d 回（都重试成功）' % (m.get('抖动回数') or 0),
+                 '- 在局受阻（NPC 拒绝、事不可办等写实摩擦）：%d 回' % (m.get('在局受阻回数') or 0),
+                 '- 用时：合计 %.1f 分，每回均值 %.0f 秒' % (ms / 60000.0, ms / max(1, n) / 1000.0),
+                 '- 花费：合计 ¥%.2f，每回均值 ¥%.2f（快型号官方价目，含工作日高峰翻倍；调用 %d 次，输入 %d token、输出 %d token）' % (c['yuan'], avg, c['calls'], c['inn'], c['out']),
+                 '- 刷新恢复：' + (('第 %s 回刷新后仍在第 %s 回、年月 %s→%s' % (m['reload'].get('turnPre'), m['reload'].get('turnPost'), m['reload'].get('yPre'), m['reload'].get('yPost'))) if m.get('reload') else '未记'),
+                 '']
+        if m.get('拦下回数'):
+            lines += ['## 引擎拦下的回', '', '| 回 | 原话 | 拦下信息（前 160 字） |', '|---|---|---|']
+            for t in turns:
+                if t.get('blocked'):
+                    blob = ((t.get('err') or '') + ' ' + (t.get('receipt') or '')).strip().replace('\n', ' ')[:160]
+                    lines.append('| %s | %s | %s |' % (t.get('i'), (t.get('said') or '').replace('|', '/'), blob.replace('|', '/')))
+            lines.append('')
+        lines += ['## 逐回', '', '| 回 | 成功 | 用时秒 | 年月 | 政权 | 正文长 | 备注 |', '|---|---|---|---|---|---|---|']
+        for t in turns:
+            lines.append('| %s | %s | %.0f | %s | %s | %s | %s |' % (
+                t.get('i'), '是' if t.get('ok') else '否', (t.get('ms') or 0) / 1000.0,
+                t.get('when') or '', t.get('pol') or '', t.get('tlen') or 0, ''))
+        lines += ['', '## 原文摘录', '']
+        for i in ('1', '8', '15', '22', '30'):
+            txt = (m.get('excerpts') or {}).get(i)
+            if txt:
+                lines += ['**第 %s 回**：%s' % (i, txt), '']
+        body = '\n'.join(lines) + '\n'
+        # 一套一条字面量路径，路径不拼接（Mimosa 规矩）
+        if k == 'chu':
+            open('C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/records/2026-11-21-chu.md', 'w', encoding='utf8', newline='\n').write(body)
+        elif k == 'huofa1':
+            open('C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/records/2026-11-21-huofa1.md', 'w', encoding='utf8', newline='\n').write(body)
+        elif k == 'huofa2':
+            open('C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/records/2026-11-21-huofa2.md', 'w', encoding='utf8', newline='\n').write(body)
+        elif k == 'huofa3':
+            open('C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/records/2026-11-21-huofa3.md', 'w', encoding='utf8', newline='\n').write(body)
+        elif k == 'chuwar':
+            open('C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/records/2026-11-21-chuwar.md', 'w', encoding='utf8', newline='\n').write(body)
+        elif k == 'wild1':
+            open('C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/records/2026-11-21-wild1.md', 'w', encoding='utf8', newline='\n').write(body)
+        elif k == 'wild2':
+            open('C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/records/2026-11-21-wild2.md', 'w', encoding='utf8', newline='\n').write(body)
+        elif k == 'wengu':
+            open('C:/Users/DELL/.zcode/workspace/draft-533289f1-c5cc-46ef-84c4-8ae6031e4ae0/work/t13build/records/2026-11-21-wengu.md', 'w', encoding='utf8', newline='\n').write(body)
