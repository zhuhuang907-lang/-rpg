#!/bin/bash
# 推送前拦截（2026-11-21 项目主人：zcode 交的东西不许直接放进预备分支）：zcode 的身份只许推 zcode/… 分支，claude/… 和 main 一律拒
ZNAME='^(宣武军节度使|xuanwujunjiedushi|zcode)$'; me=$(git config user.name 2>/dev/null)
echo "$me" | grep -qE "$ZNAME" || exit 0
while read -r lref lsha rref rsha; do
  case "$rref" in refs/heads/claude/*|refs/heads/main) echo "【推送前检查】zcode 不许推 ${rref#refs/heads/}：只推 zcode/… 自己的分支，交了在问答里说一声，Claude 审过再合（AGENTS.md）"; exit 1;; esac
done
exit 0
