[{"a": "李克用", "b": "李嗣昭", "rel": "养父（命弟克柔养为子，赐名）", "year": 890, "note": "出猎汾州见林中有气，遗金帛取其儿", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李嗣本", "rel": "养父（赐姓名）", "year": 890, "note": "嗣本少事太祖，爱之养为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李嗣恩", "rel": "养父（赐姓名）", "year": 890, "note": "为铁林军将，稍以战功赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存信", "rel": "养父（赐姓名）", "year": 880, "note": "从起代北入关破黄巢，遂赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存孝", "rel": "养父（赐姓名）", "year": 886, "note": "掠地代北得之，给事帐中赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存进", "rel": "养父（赐姓名）", "year": 883, "note": "攻破朔州得之，赐姓名养为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存璋", "rel": "义儿（受顾命）", "year": 908, "note": "太祖病革，璋与张承业等受顾命立庄宗", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存贤", "rel": "养父（赐姓名）", "year": 883, "note": "击黄巢于陈州得之，赐姓名养为子", "src": "新五代史·卷36"}, {"a": "李存信", "b": "李存孝", "rel": "交恶进谗", "year": 892, "note": "存信谮存孝有二心常避赵不击，存孝遂附梁反晋", "src": "新五代史·卷36"}, {"a": "康君立", "b": "李存信", "rel": "相善左袒", "year": 892, "note": "君立每左右存信以倾存孝", "src": "新五代史·卷36"}, {"a": "李克用", "b": "康君立", "rel": "怒而鸩杀", "year": 894, "note": "语及存孝流涕，君立以为不然，太祖怒鸖杀之", "src": "新五代史·卷36"}, {"a": "李嗣昭", "b": "李继韬", "rel": "父子（继韬囚兄自立）", "year": 922, "note": "嗣昭卒，继韬囚长兄继俦以自立，后伏诛", "src": "新五代史·卷36"}, {"a": "周匝", "b": "陈俊", "rel": "乞恩报德", "year": 926, "note": "周匝谓身陷仇人不死，赖俊与德源之力，请除二州刺史", "src": "新五代史·卷37"}, {"a": "周匝", "b": "储德源", "rel": "乞恩报德", "year": 926, "note": "同上，卒以俊为景州刺史、德源为宪州刺史", "src": "新五代史·卷37"}, {"a": "贺瓌", "b": "谢彦章", "rel": "忌而伏甲杀之", "year": 918, "note": "瓌疑彦章以营地告晋，使朱珪诬其将反而杀之；庄宗喜曰：将帅不和，梁亡无日矣", "src": "新五代史·卷23"}, {"a": "郭崇韬", "b": "罗贯", "rel": "知遇而救不得", "year": 925, "note": "贯为崇韬所知，坤陵桥道之狱崇韬谏「罪不当死」，庄宗怒阖殿门，贯卒见杀", "src": "新五代史·卷24"}, {"a": "安重诲", "b": "杨彦温", "rel": "阴图潞王使叛", "year": 931, "note": "重诲以从珂非李氏子后必为患；彦温闭城自言得枢密院宣；事败彦温被斩灭口", "src": "新五代史·卷24"}, {"a": "韩玫", "b": "乌昭遇", "rel": "辱使而返谮", "year": 931, "note": "玫恃重诲势醉以马箠击昭遇，还谮其舞蹈称臣私告镠，昭遇坐死御史狱", "src": "新五代史·卷24"}]