[{"a": "李克用", "b": "李嗣昭", "rel": "养父（命弟克柔养为子，赐名）", "year": 890, "note": "出猎汾州见林中有气，遗金帛取其儿", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李嗣本", "rel": "养父（赐姓名）", "year": 890, "note": "嗣本少事太祖，爱之养为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李嗣恩", "rel": "养父（赐姓名）", "year": 890, "note": "为铁林军将，稍以战功赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存信", "rel": "养父（赐姓名）", "year": 880, "note": "从起代北入关破黄巢，遂赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存孝", "rel": "养父（赐姓名）", "year": 886, "note": "掠地代北得之，给事帐中赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存进", "rel": "养父（赐姓名）", "year": 883, "note": "攻破朔州得之，赐姓名养为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存璋", "rel": "义儿（受顾命）", "year": 908, "note": "太祖病革，璋与张承业等受顾命立庄宗", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存贤", "rel": "养父（赐姓名）", "year": 883, "note": "击黄巢于陈州得之，赐姓名养为子", "src": "新五代史·卷36"}, {"a": "李存信", "b": "李存孝", "rel": "交恶进谗", "year": 892, "note": "存信谮存孝有二心常避赵不击，存孝遂附梁反晋", "src": "新五代史·卷36"}, {"a": "康君立", "b": "李存信", "rel": "相善左袒", "year": 892, "note": "君立每左右存信以倾存孝", "src": "新五代史·卷36"}, {"a": "李克用", "b": "康君立", "rel": "怒而鸩杀", "year": 894, "note": "语及存孝流涕，君立以为不然，太祖怒鸖杀之", "src": "新五代史·卷36"}, {"a": "李嗣昭", "b": "李继韬", "rel": "父子（继韬囚兄自立）", "year": 922, "note": "嗣昭卒，继韬囚长兄继俦以自立，后伏诛", "src": "新五代史·卷36"}, {"a": "周匝", "b": "陈俊", "rel": "乞恩报德", "year": 926, "note": "周匝谓身陷仇人不死，赖俊与德源之力，请除二州刺史", "src": "新五代史·卷37"}, {"a": "周匝", "b": "储德源", "rel": "乞恩报德", "year": 926, "note": "同上，卒以俊为景州刺史、德源为宪州刺史", "src": "新五代史·卷37"}, {"a": "贺瓌", "b": "谢彦章", "rel": "忌而伏甲杀之", "year": 918, "note": "瓌疑彦章以营地告晋，使朱珪诬其将反而杀之；庄宗喜曰：将帅不和，梁亡无日矣", "src": "新五代史·卷23"}, {"a": "郭崇韬", "b": "罗贯", "rel": "知遇而救不得", "year": 925, "note": "贯为崇韬所知，坤陵桥道之狱崇韬谏「罪不当死」，庄宗怒阖殿门，贯卒见杀", "src": "新五代史·卷24"}, {"a": "安重诲", "b": "杨彦温", "rel": "阴图潞王使叛", "year": 931, "note": "重诲以从珂非李氏子后必为患；彦温闭城自言得枢密院宣；事败彦温被斩灭口", "src": "新五代史·卷24"}, {"a": "韩玫", "b": "乌昭遇", "rel": "辱使而返谮", "year": 931, "note": "玫恃重诲势醉以马箠击昭遇，还谮其舞蹈称臣私告镠，昭遇坐死御史狱", "src": "新五代史·卷24"}, {"a": "周德威", "b": "李嗣昭", "rel": "素有隙，破夹城后欢如初", "year": 908, "note": "晋王病革忧之；德威闻丧即日还军太原，伏梓宫恸哭几绝，晋人乃安", "src": "新五代史·卷25"}, {"a": "周德威", "b": "王景仁", "rel": "柏乡大破之", "year": 911, "note": "德威退军鄗邑诱敌，至未申鼓噪而进，梁阵动皆走，横尸数十里", "src": "新五代史·卷25"}, {"a": "符存审", "b": "郭崇韬", "rel": "名望相轧，沮其来朝", "year": 924, "note": "崇韬不乐存审来加己上，其妻郭氏泣诉亦怒；崇韬度其病亟乃请许来朝", "src": "新五代史·卷25"}, {"a": "符存审", "b": "李嗣昭", "rel": "同救河中朱友谦", "year": 916, "note": "存审选精骑二百杂河中兵阳败诱𬩽，反击获其骑五十，按军伺隙大败刘𬩽", "src": "新五代史·卷25"}, {"a": "符存审", "b": "符彦超", "rel": "父子", "year": 924, "note": "存审三子彦超、彦饶、彦卿皆显", "src": "新五代史·卷25"}, {"a": "符彦超", "b": "符彦饶", "rel": "兄弟", "year": 926, "note": "彦超巡检北京杀存霸；彦饶汴州诛谏；皆存审子", "src": "新五代史·卷25"}, {"a": "符存审", "b": "史建瑭", "rel": "同守赵州拒梁太祖", "year": 912, "note": "存审扼下博桥，建瑭五队掠梁刍牧、百骑夜叩梁营，梁太祖夜拔营去", "src": "新五代史·卷25"}, {"a": "李建及", "b": "贺瓌", "rel": "德胜南城之战胜之", "year": 916, "note": "瓌以竹笮维战舰，建及以大瓮积薪上流纵火，斧其竹笮，梁兵皆走", "src": "新五代史·卷25"}, {"a": "孔谦", "b": "郭崇韬", "rel": "求为租庸使不得，怨而斗", "year": 923, "note": "崇韬用张宪为租庸使以谦为副，谦怏怏；又倡罢宪以正言代之", "src": "新五代史·卷26"}, {"a": "孔谦", "b": "景进", "rel": "赖其救解", "year": 924, "note": "谦求解职，庄宗怒欲寘之法，赖伶官景进救解乃止；后景进数以为言罢正言而谦为租庸使", "src": "新五代史·卷26"}, {"a": "孔谦", "b": "王正言", "rel": "排宪而立之，继而不相能", "year": 924, "note": "谦谓「邺都天下之重不可轻以任人」罢宪，以正言为租庸使；正言病风不任事，谦遂得其位", "src": "新五代史·卷26"}, {"a": "李仁矩", "b": "安重诲", "rel": "亲信而委以制璋", "year": 929, "note": "仁矩素为重诲亲信；重诲分阆州为保宁军以仁矩为节度使以制董璋，璋反攻阆州，仁矩被擒家属皆见杀", "src": "新五代史·卷26"}, {"a": "朱弘昭", "b": "安重诲", "rel": "谗构致其死", "year": 932, "note": "弘昭迎谒礼甚恭，酒酣得重诲怨望之言即奏之，又驰告敬瑭拒重诲；重诲过凤翔，闭门不纳，由此得罪死", "src": "新五代史·卷27"}, {"a": "朱弘昭", "b": "冯赟", "rel": "并掌机务，同日俱死", "year": 933, "note": "代延寿延光秉枢密；汉琼、王淑妃用事，大事皆决此四人；从珂兵东，弘昭投井，从进杀赟", "src": "新五代史·卷27"}, {"a": "康义诚", "b": "朱弘昭", "rel": "从荣案持两端相表里", "year": 933, "note": "弘昭等以反白明宗，涕泣召义诚使自处置，义诚卒不出兵", "src": "新五代史·卷27"}, {"a": "药彦稠", "b": "杨彦温", "rel": "希旨杀以灭口", "year": 931, "note": "明宗戒得彦温毋杀将讯之，彦稠希重诲旨杀彦温以灭口", "src": "新五代史·卷27"}, {"a": "药彦稠", "b": "安重诲", "rel": "希旨行事", "year": 931, "note": "矫诏遣彦温逐从珂本出重诲，彦稠杀之以灭口；明宗不之罪", "src": "新五代史·卷27"}, {"a": "豆卢革", "b": "韦说", "rel": "荐相相倚，俱贬死", "year": 924, "note": "革荐说「能知前朝事」；说教门人上书言崇韬事；二人各以其子为拾遗父子同省；俱为希甫诬奏贬死", "src": "新五代史·卷28"}, {"a": "萧希甫", "b": "豆卢革", "rel": "诬奏革纵田客杀人", "year": 926, "note": "希甫希重诲旨诬奏，有司推劾井中惟破釜，革说终皆贬死", "src": "新五代史·卷28"}, {"a": "萧希甫", "b": "韦说", "rel": "诬奏说与邻人争井", "year": 926, "note": "井有宝货之说，推劾惟破釜", "src": "新五代史·卷28"}, {"a": "卢程", "b": "任圜", "rel": "骂虫豸致庄宗趣令自尽", "year": 923, "note": "程帖兴唐府给驴夫笞吏背，圜诣诉，程骂「尔何虫豸，恃妇家力也」；庄宗怒「朕悮相此痴物」，卢质力解", "src": "新五代史·卷28"}, {"a": "任圜", "b": "安重诲", "rel": "争权交恶，矫制杀之", "year": 927, "note": "使臣给券之争、妓事之恶；守殷反，重诲诬圜与通谋，遣人矫制杀之，圜怡然聚族酣饮而死", "src": "新五代史·卷28"}, {"a": "赵凤", "b": "任圜", "rel": "素善荐进，杀之独号哭", "year": 927, "note": "凤自圜为相颇荐进之；圜被诬谋反，凤独号哭呼重诲曰「任圜天下义士，岂肯谋反！」重诲惭不能对", "src": "新五代史·卷28"}, {"a": "赵凤", "b": "安重诲", "rel": "手疏切责，败后独言其忠", "year": 929, "note": "罢幸邺手疏责重诲言甚切直；重诲得罪群臣无敢言者，独凤数言重诲尽忠，明宗以凤为朋党罢之", "src": "新五代史·卷28"}, {"a": "张宪", "b": "史彦琼", "rel": "库钱之诘，伶为之解", "year": 925, "note": "庄宗谓彦琼曰「我与群臣博须钱十余万，而宪以故纸绐我」，彦琼为宪解之乃已", "src": "新五代史·卷28"}, {"a": "张宪", "b": "符彦超", "rel": "存霸案牵连而死", "year": 926, "note": "存霸奔太原愿为僧求生，彦超麾下兵噪而杀之；宪出奔沂州亦见杀", "src": "新五代史·卷28"}, {"a": "朱弘昭", "b": "刘赞", "rel": "争免秦王属官之死", "year": 933, "note": "冯道议原减，弘昭曰「使秦王得入光政门，当待赞等如何」，赟亦争，赞等乃免死", "src": "新五代史·卷28"}, {"a": "桑维翰", "b": "景延广", "rel": "盟成于维翰败于延广", "year": 944, "note": "自契丹与晋盟始成于维翰而终败于延广；契丹书檄未尝不以两人为言", "src": "新五代史·卷29"}, {"a": "苏逢吉", "b": "史弘肇", "rel": "将相如水火", "year": 949, "note": "会王章第使酒，弘肇索剑欲追之，杨邠泣曰「苏公汉宰相，公若杀之致天子何地乎」；王峻置酒和解", "src": "新五代史·卷30"}, {"a": "史弘肇", "b": "杨邠", "rel": "同授顾命，同日族诛", "year": 950, "note": "与王章等入朝坐广政殿东庑，甲士自内出擒斩之，并族其三家", "src": "新五代史·卷30"}, {"a": "史弘肇", "b": "王章", "rel": "毛锥子之争", "year": 950, "note": "弘肇曰长枪大剑若毛锥子安足用哉；章曰无毛锥子军赋何从集乎，弘肇默然", "src": "新五代史·卷30"}, {"a": "苏逢吉", "b": "杨邠", "rel": "内相排忌", "year": 949, "note": "逢吉讽李涛上疏罢邠与周太祖枢密，邠泣诉李太后前，太后怒罢涛相，事悉关决", "src": "新五代史·卷30"}, {"a": "郭允明", "b": "杨邠", "rel": "手杀其诸子于朝堂", "year": 950, "note": "载邠等十余尸暴之市中，允明手杀邠等诸子于朝堂西庑，王章壻张贻肃血流逆注", "src": "新五代史·卷30"}, {"a": "后赞", "b": "张延朗", "rel": "幼善讴事延朗", "year": 944, "note": "延朗死赞更事汉高祖，以为牙将", "src": "新五代史·卷30"}, {"a": "王朴", "b": "杨邠", "rel": "见将相交恶去邠东归独免", "year": 948, "note": "朴依邠为校书郎，知其必乱乃去东归；后邠与章弘肇皆见杀三家之客多及而朴独免", "src": "新五代史·卷31"}, {"a": "王朴", "b": "扈载", "rel": "尤重其才力荐", "year": 956, "note": "朴荐载于李谷久不用，谷曰载命薄恐不能胜，朴曰「何言命邪」，已而召拜知制诰", "src": "新五代史·卷31"}]