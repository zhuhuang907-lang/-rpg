[{"a": "李克用", "b": "李嗣昭", "rel": "养父（命弟克柔养为子，赐名）", "year": 890, "note": "出猎汾州见林中有气，遗金帛取其儿", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李嗣本", "rel": "养父（赐姓名）", "year": 890, "note": "嗣本少事太祖，爱之养为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李嗣恩", "rel": "养父（赐姓名）", "year": 890, "note": "为铁林军将，稍以战功赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存信", "rel": "养父（赐姓名）", "year": 880, "note": "从起代北入关破黄巢，遂赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存孝", "rel": "养父（赐姓名）", "year": 886, "note": "掠地代北得之，给事帐中赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存进", "rel": "养父（赐姓名）", "year": 883, "note": "攻破朔州得之，赐姓名养为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存璋", "rel": "义儿（受顾命）", "year": 908, "note": "太祖病革，璋与张承业等受顾命立庄宗", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存贤", "rel": "养父（赐姓名）", "year": 883, "note": "击黄巢于陈州得之，赐姓名养为子", "src": "新五代史·卷36"}, {"a": "李存信", "b": "李存孝", "rel": "交恶进谗", "year": 892, "note": "存信谮存孝有二心常避赵不击，存孝遂附梁反晋", "src": "新五代史·卷36"}, {"a": "康君立", "b": "李存信", "rel": "相善左袒", "year": 892, "note": "君立每左右存信以倾存孝", "src": "新五代史·卷36"}, {"a": "李克用", "b": "康君立", "rel": "怒而鸩杀", "year": 894, "note": "语及存孝流涕，君立以为不然，太祖怒鸖杀之", "src": "新五代史·卷36"}, {"a": "李嗣昭", "b": "李继韬", "rel": "父子（继韬囚兄自立）", "year": 922, "note": "嗣昭卒，继韬囚长兄继俦以自立，后伏诛", "src": "新五代史·卷36"}, {"a": "周匝", "b": "陈俊", "rel": "乞恩报德", "year": 926, "note": "周匝谓身陷仇人不死，赖俊与德源之力，请除二州刺史", "src": "新五代史·卷37"}, {"a": "周匝", "b": "储德源", "rel": "乞恩报德", "year": 926, "note": "同上，卒以俊为景州刺史、德源为宪州刺史", "src": "新五代史·卷37"}, {"a": "贺瓌", "b": "谢彦章", "rel": "忌而伏甲杀之", "year": 918, "note": "瓌疑彦章以营地告晋，使朱珪诬其将反而杀之；庄宗喜曰：将帅不和，梁亡无日矣", "src": "新五代史·卷23"}, {"a": "郭崇韬", "b": "罗贯", "rel": "知遇而救不得", "year": 925, "note": "贯为崇韬所知，坤陵桥道之狱崇韬谏「罪不当死」，庄宗怒阖殿门，贯卒见杀", "src": "新五代史·卷24"}, {"a": "安重诲", "b": "杨彦温", "rel": "阴图潞王使叛", "year": 931, "note": "重诲以从珂非李氏子后必为患；彦温闭城自言得枢密院宣；事败彦温被斩灭口", "src": "新五代史·卷24"}, {"a": "韩玫", "b": "乌昭遇", "rel": "辱使而返谮", "year": 931, "note": "玫恃重诲势醉以马箠击昭遇，还谮其舞蹈称臣私告镠，昭遇坐死御史狱", "src": "新五代史·卷24"}, {"a": "周德威", "b": "李嗣昭", "rel": "素有隙，破夹城后欢如初", "year": 908, "note": "晋王病革忧之；德威闻丧即日还军太原，伏梓宫恸哭几绝，晋人乃安", "src": "新五代史·卷25"}, {"a": "周德威", "b": "王景仁", "rel": "柏乡大破之", "year": 911, "note": "德威退军鄗邑诱敌，至未申鼓噪而进，梁阵动皆走，横尸数十里", "src": "新五代史·卷25"}, {"a": "符存审", "b": "郭崇韬", "rel": "名望相轧，沮其来朝", "year": 924, "note": "崇韬不乐存审来加己上，其妻郭氏泣诉亦怒；崇韬度其病亟乃请许来朝", "src": "新五代史·卷25"}, {"a": "符存审", "b": "李嗣昭", "rel": "同救河中朱友谦", "year": 916, "note": "存审选精骑二百杂河中兵阳败诱𬩽，反击获其骑五十，按军伺隙大败刘𬩽", "src": "新五代史·卷25"}, {"a": "符存审", "b": "符彦超", "rel": "父子", "year": 924, "note": "存审三子彦超、彦饶、彦卿皆显", "src": "新五代史·卷25"}, {"a": "符彦超", "b": "符彦饶", "rel": "兄弟", "year": 926, "note": "彦超巡检北京杀存霸；彦饶汴州诛谏；皆存审子", "src": "新五代史·卷25"}, {"a": "符存审", "b": "史建瑭", "rel": "同守赵州拒梁太祖", "year": 912, "note": "存审扼下博桥，建瑭五队掠梁刍牧、百骑夜叩梁营，梁太祖夜拔营去", "src": "新五代史·卷25"}, {"a": "李建及", "b": "贺瓌", "rel": "德胜南城之战胜之", "year": 916, "note": "瓌以竹笮维战舰，建及以大瓮积薪上流纵火，斧其竹笮，梁兵皆走", "src": "新五代史·卷25"}, {"a": "孔谦", "b": "郭崇韬", "rel": "求为租庸使不得，怨而斗", "year": 923, "note": "崇韬用张宪为租庸使以谦为副，谦怏怏；又倡罢宪以正言代之", "src": "新五代史·卷26"}, {"a": "孔谦", "b": "景进", "rel": "赖其救解", "year": 924, "note": "谦求解职，庄宗怒欲寘之法，赖伶官景进救解乃止；后景进数以为言罢正言而谦为租庸使", "src": "新五代史·卷26"}, {"a": "孔谦", "b": "王正言", "rel": "排宪而立之，继而不相能", "year": 924, "note": "谦谓「邺都天下之重不可轻以任人」罢宪，以正言为租庸使；正言病风不任事，谦遂得其位", "src": "新五代史·卷26"}, {"a": "李仁矩", "b": "安重诲", "rel": "亲信而委以制璋", "year": 929, "note": "仁矩素为重诲亲信；重诲分阆州为保宁军以仁矩为节度使以制董璋，璋反攻阆州，仁矩被擒家属皆见杀", "src": "新五代史·卷26"}, {"a": "朱弘昭", "b": "安重诲", "rel": "谗构致其死", "year": 932, "note": "弘昭迎谒礼甚恭，酒酣得重诲怨望之言即奏之，又驰告敬瑭拒重诲；重诲过凤翔，闭门不纳，由此得罪死", "src": "新五代史·卷27"}, {"a": "朱弘昭", "b": "冯赟", "rel": "并掌机务，同日俱死", "year": 933, "note": "代延寿延光秉枢密；汉琼、王淑妃用事，大事皆决此四人；从珂兵东，弘昭投井，从进杀赟", "src": "新五代史·卷27"}, {"a": "康义诚", "b": "朱弘昭", "rel": "从荣案持两端相表里", "year": 933, "note": "弘昭等以反白明宗，涕泣召义诚使自处置，义诚卒不出兵", "src": "新五代史·卷27"}, {"a": "药彦稠", "b": "杨彦温", "rel": "希旨杀以灭口", "year": 931, "note": "明宗戒得彦温毋杀将讯之，彦稠希重诲旨杀彦温以灭口", "src": "新五代史·卷27"}, {"a": "药彦稠", "b": "安重诲", "rel": "希旨行事", "year": 931, "note": "矫诏遣彦温逐从珂本出重诲，彦稠杀之以灭口；明宗不之罪", "src": "新五代史·卷27"}, {"a": "豆卢革", "b": "韦说", "rel": "荐相相倚，俱贬死", "year": 924, "note": "革荐说「能知前朝事」；说教门人上书言崇韬事；二人各以其子为拾遗父子同省；俱为希甫诬奏贬死", "src": "新五代史·卷28"}, {"a": "萧希甫", "b": "豆卢革", "rel": "诬奏革纵田客杀人", "year": 926, "note": "希甫希重诲旨诬奏，有司推劾井中惟破釜，革说终皆贬死", "src": "新五代史·卷28"}, {"a": "萧希甫", "b": "韦说", "rel": "诬奏说与邻人争井", "year": 926, "note": "井有宝货之说，推劾惟破釜", "src": "新五代史·卷28"}, {"a": "卢程", "b": "任圜", "rel": "骂虫豸致庄宗趣令自尽", "year": 923, "note": "程帖兴唐府给驴夫笞吏背，圜诣诉，程骂「尔何虫豸，恃妇家力也」；庄宗怒「朕悮相此痴物」，卢质力解", "src": "新五代史·卷28"}, {"a": "任圜", "b": "安重诲", "rel": "争权交恶，矫制杀之", "year": 927, "note": "使臣给券之争、妓事之恶；守殷反，重诲诬圜与通谋，遣人矫制杀之，圜怡然聚族酣饮而死", "src": "新五代史·卷28"}, {"a": "赵凤", "b": "任圜", "rel": "素善荐进，杀之独号哭", "year": 927, "note": "凤自圜为相颇荐进之；圜被诬谋反，凤独号哭呼重诲曰「任圜天下义士，岂肯谋反！」重诲惭不能对", "src": "新五代史·卷28"}, {"a": "赵凤", "b": "安重诲", "rel": "手疏切责，败后独言其忠", "year": 929, "note": "罢幸邺手疏责重诲言甚切直；重诲得罪群臣无敢言者，独凤数言重诲尽忠，明宗以凤为朋党罢之", "src": "新五代史·卷28"}, {"a": "张宪", "b": "史彦琼", "rel": "库钱之诘，伶为之解", "year": 925, "note": "庄宗谓彦琼曰「我与群臣博须钱十余万，而宪以故纸绐我」，彦琼为宪解之乃已", "src": "新五代史·卷28"}, {"a": "张宪", "b": "符彦超", "rel": "存霸案牵连而死", "year": 926, "note": "存霸奔太原愿为僧求生，彦超麾下兵噪而杀之；宪出奔沂州亦见杀", "src": "新五代史·卷28"}, {"a": "朱弘昭", "b": "刘赞", "rel": "争免秦王属官之死", "year": 933, "note": "冯道议原减，弘昭曰「使秦王得入光政门，当待赞等如何」，赟亦争，赞等乃免死", "src": "新五代史·卷28"}, {"a": "桑维翰", "b": "景延广", "rel": "盟成于维翰败于延广", "year": 944, "note": "自契丹与晋盟始成于维翰而终败于延广；契丹书檄未尝不以两人为言", "src": "新五代史·卷29"}, {"a": "苏逢吉", "b": "史弘肇", "rel": "将相如水火", "year": 949, "note": "会王章第使酒，弘肇索剑欲追之，杨邠泣曰「苏公汉宰相，公若杀之致天子何地乎」；王峻置酒和解", "src": "新五代史·卷30"}, {"a": "史弘肇", "b": "杨邠", "rel": "同授顾命，同日族诛", "year": 950, "note": "与王章等入朝坐广政殿东庑，甲士自内出擒斩之，并族其三家", "src": "新五代史·卷30"}, {"a": "史弘肇", "b": "王章", "rel": "毛锥子之争", "year": 950, "note": "弘肇曰长枪大剑若毛锥子安足用哉；章曰无毛锥子军赋何从集乎，弘肇默然", "src": "新五代史·卷30"}, {"a": "苏逢吉", "b": "杨邠", "rel": "内相排忌", "year": 949, "note": "逢吉讽李涛上疏罢邠与周太祖枢密，邠泣诉李太后前，太后怒罢涛相，事悉关决", "src": "新五代史·卷30"}, {"a": "郭允明", "b": "杨邠", "rel": "手杀其诸子于朝堂", "year": 950, "note": "载邠等十余尸暴之市中，允明手杀邠等诸子于朝堂西庑，王章壻张贻肃血流逆注", "src": "新五代史·卷30"}, {"a": "后赞", "b": "张延朗", "rel": "幼善讴事延朗", "year": 944, "note": "延朗死赞更事汉高祖，以为牙将", "src": "新五代史·卷30"}, {"a": "王朴", "b": "杨邠", "rel": "见将相交恶去邠东归独免", "year": 948, "note": "朴依邠为校书郎，知其必乱乃去东归；后邠与章弘肇皆见杀三家之客多及而朴独免", "src": "新五代史·卷31"}, {"a": "王朴", "b": "扈载", "rel": "尤重其才力荐", "year": 956, "note": "朴荐载于李谷久不用，谷曰载命薄恐不能胜，朴曰「何言命邪」，已而召拜知制诰", "src": "新五代史·卷31"}, {"a": "王彦章", "b": "夏鲁奇", "rel": "同乡旧识，阵上擒之", "year": 923, "note": "鲁奇素与彦章善，识其语音曰「王铁枪也」，举矟刺之，彦章伤重马踣被擒", "src": "新五代史·卷33"}, {"a": "刘仁赡", "b": "孙晟", "rel": "同守寿州之局", "year": 956, "note": "孙晟使周留不遣，仁赡守寿州；二人皆以死节称", "src": "新五代史·卷32—33"}, {"a": "刘仁赡", "b": "刘彦贞", "rel": "谏其勿追，彦贞不听败于正阳", "year": 955, "note": "李谷退守正阳浮桥，彦贞意其怯急追之，仁赡以为不可，彦贞不听，果败", "src": "新五代史·卷32"}, {"a": "张承业", "b": "张居翰", "rel": "宦官两派，承业主藏居翰默默", "year": 923, "note": "居翰与郭崇韬并为枢密使，崇韬专任政，居翰默默苟免；承业主藏，庄宗求钱不可得", "src": "新五代史·卷38"}, {"a": "马绍宏", "b": "郭崇韬", "rel": "争枢密使之位结怨", "year": 923, "note": "二人俱为中门使而绍宏位在上；崇韬不欲绍宏在己上，乃以张居翰为枢密使，绍宏为宣徽使，失职怨望", "src": "新五代史·卷24、卷38"}, {"a": "孟汉琼", "b": "朱弘昭", "rel": "并掌机务，同陷秦王", "year": 933, "note": "弘昭等方图其事议未决，汉琼遽入见明宗言秦王反，即以兵诛之", "src": "新五代史·卷27、卷38"}, {"a": "张敬达", "b": "石敬瑭", "rel": "分其兵权致其反", "year": 936, "note": "废帝疑敬瑭有异志，以敬达为北面副总管分其兵；徙敬瑭镇天平，敬达为都部署，敬瑭因此遂反", "src": "新五代史·卷33"}, {"a": "王清", "b": "杜重威", "rel": "请战而主将不进，独死", "year": 946, "note": "清请以步兵二千夺桥开路，重威许之而犹豫不进，彦筠亦退，清曰「吾独死于此矣」力战而死", "src": "新五代史·卷33"}, {"a": "郑遨", "b": "李振", "rel": "故善，贵不仕，窜则千里往省", "year": 915, "note": "振事梁贵显欲以禄遨，遨不顾；振得罪南窜，遨徒步千里往省之，闻者益高其行", "src": "新五代史·卷34"}, {"a": "敬翔", "b": "李振", "rel": "并佐朱温倾唐，同列崇政院", "year": 907, "note": "昭宗还长安御延喜楼召翔与李振登楼劳问，翔授检校右仆射太府卿赐号迎銮协赞功臣；二人同倾唐祚", "src": "旧五代史·卷18"}, {"a": "李振", "b": "裴枢", "rel": "白马驿之谋，劝投清流于河", "year": 905, "note": "柳璨谮杀裴枢陆扆等七人于滑州白马驿，振谓太祖「此辈自谓清流，宜投于黄河，永为浊流」", "src": "旧五代史·卷18"}, {"a": "朱珍", "b": "庞师古", "rel": "同以中涓从太祖起兵", "year": 880, "note": "珍与师古、许唐、李晖、丁会、氏叔琮、邓季筠、王武等八十余人以中涓从，摧坚陷阵所向荡决", "src": "旧五代史·卷19"}, {"a": "朱珍", "b": "氏叔琮", "rel": "同列中涓八十余人", "year": 880, "note": "叔琮初隶庞师古为伍长，与朱珍等同从太祖", "src": "旧五代史·卷19"}, {"a": "王重师", "b": "刘捍", "rel": "为捍所构，太祖疑之", "year": 908, "note": "开平中为刘捍所构，太祖深疑之，然未有以发其事", "src": "旧五代史·卷19"}, {"a": "氏叔琮", "b": "朱友宁", "rel": "受命节制其军", "year": 902, "note": "太祖遣朱友宁将兵数万赴应，悉委叔琮节制", "src": "旧五代史·卷19"}, {"a": "胡规", "b": "葛从周", "rel": "佐其伐镇定", "year": 898, "note": "胡规佐葛从周伐镇、定，从张存敬收晋、绛，皆有功", "src": "旧五代史·卷19"}, {"a": "张文靖", "b": "葛从周", "rel": "佐其统大军御晋", "year": 899, "note": "文靖佐葛从周统大军御之，至沙河败晋军五千余骑，擒蕃将百余人", "src": "旧五代史·卷19"}, {"a": "葛从周", "b": "霍存", "rel": "同自巢军来降", "year": 884, "note": "王满渡太祖大破巢军，从周与霍存、张归霸昆弟相率来降", "src": "旧五代史·卷16"}, {"a": "葛从周", "b": "张归霸", "rel": "同自巢军来降", "year": 884, "note": "归霸昆仲与葛从周、李谠等相率来降，寻补宣武军剧职", "src": "旧五代史·卷16"}, {"a": "张归霸", "b": "张归厚", "rel": "兄弟同降", "year": 884, "note": "归厚与兄归霸自巢军来降；张归霸女为梁末帝德妃", "src": "旧五代史·卷16"}, {"a": "葛从周", "b": "贺德伦", "rel": "同率五百骑死战馆陶门", "year": 898, "note": "从周与贺德伦率五百骑出战，德伦命阖门曰「前有敌，不可返顾」，大败燕人", "src": "旧五代史·卷16"}, {"a": "葛从周", "b": "蒋元晖", "rel": "都监与主将之争", "year": 899, "note": "蒋元晖谓当纵燕军入壁，从周对曰「兵在机，机在上将，非督护所言也」", "src": "旧五代史·卷16"}, {"a": "牛存节", "b": "张全义", "rel": "率军赴河阳解其围", "year": 888, "note": "李罕之以并军围张宗奭于河阳，太祖遣存节率军赴之（张宗奭即张全义）", "src": "旧五代史·卷22"}, {"a": "康怀英", "b": "葛从周", "rel": "同领兵渡淮", "year": 899, "note": "其年冬与康怀英渡淮入寿春之境，下安丰霍丘至光州而还", "src": "旧五代史·卷16"}, {"a": "徐温", "b": "严可求", "rel": "谋主，军旅问可求", "year": 905, "note": "温用其客严可求谋，教行密阳为目疾，事成迁右衙指挥使；行密疾，温与可求入问疾取召符速遣渥", "src": "新五代史·卷61"}, {"a": "徐温", "b": "骆知祥", "rel": "国用问知祥，吴人称严骆", "year": 910, "note": "温客尤见信者惟骆知祥严可求，可求善筹划知祥长于财利，温以军旅问可求国用问知祥", "src": "新五代史·卷61"}, {"a": "徐温", "b": "杨渥", "rel": "私嘱勿应非温使者之召", "year": 905, "note": "温私谓渥曰「若它日召子，非温使者慎无应命」，渥涕泣谢温而去", "src": "新五代史·卷61"}, {"a": "杨渥", "b": "周隐", "rel": "杀之", "year": 905, "note": "行密卒渥嗣立，召周隐骂曰「汝欲卖吾国者」，遂杀之", "src": "新五代史·卷61"}, {"a": "周隐", "b": "刘威", "rel": "荐其代主军政", "year": 905, "note": "隐虑渥幼弱不任事，劝行密用旧将有威望者代主军政，乃荐大将刘威", "src": "新五代史·卷61"}, {"a": "徐温", "b": "杨隆演", "rel": "所立之吴王", "year": 908, "note": "十六年温请隆演即皇帝位不许，又请即吴王位乃许，遂建国改元，拜温大丞相", "src": "新五代史·卷61"}, {"a": "徐温", "b": "杨溥", "rel": "越次立之，又请其称帝", "year": 920, "note": "隆演卒，温越次立其弟溥；顺义七年温又请溥即皇帝位，溥未许而温病卒", "src": "新五代史·卷61"}, {"a": "李昪", "b": "徐温", "rel": "养父子", "year": 908, "note": "徐知诰为温养子，温以军国托之；后复姓李代吴", "src": "新五代史·卷62"}, {"a": "李昪", "b": "杨溥", "rel": "受其禅代吴", "year": 937, "note": "天祚三年溥禅位于徐知诰，吴亡；昪迁杨氏子孙于海陵永宁宫严兵守之", "src": "新五代史·卷61—62"}, {"a": "杨行密", "b": "刘威", "rel": "三十六英雄之首从", "year": 890, "note": "行密所与起事刘威、陶雅之徒号三十六英雄", "src": "新五代史·卷61"}, {"a": "王建", "b": "王衍", "rel": "父子", "year": 918, "note": "建卒衍嗣立，荒纵不亲政务，925 年降后唐", "src": "新五代史·卷63"}, {"a": "孟知祥", "b": "郭崇韬", "rel": "荐以自代，崇韬德之", "year": 918, "note": "前此为中门使者多以罪诛，知祥惧求佗职，荐郭崇韬自代，崇韬德之", "src": "新五代史·卷64"}, {"a": "孟知祥", "b": "李克让", "rel": "岳父（妻其女）", "year": 915, "note": "晋王以其弟克让女妻之，以为左教练使", "src": "新五代史·卷64"}, {"a": "刘隐", "b": "刘龑", "rel": "兄弟相嗣", "year": 911, "note": "父谦三子隐台岩；隐卒龑嗣，即帝位追尊隐襄皇帝", "src": "新五代史·卷65"}, {"a": "马殷", "b": "刘龑", "rel": "争容桂", "year": 910, "note": "马殷争容桂，殷取桂管虏士政；龑取容管逐巨昭，又取邕管", "src": "新五代史·卷65"}, {"a": "钱镠", "b": "董昌", "rel": "旧主，后讨平之", "year": 896, "note": "镠以骁勇事昌为石镜都知兵马使，昌僭号镠讨平之兼有两浙", "src": "新五代史·卷67"}, {"a": "王审知", "b": "王潮", "rel": "兄弟，潮卒代领", "year": 893, "note": "兄潮为县史，绪闻潮兄弟材勇召置军中；潮卒审知代领", "src": "新五代史·卷68"}, {"a": "高季兴", "b": "高从诲", "rel": "父子", "year": 928, "note": "季兴死其子从诲请命", "src": "新五代史·卷69"}, {"a": "刘旻", "b": "刘知远", "rel": "族兄弟（汉高祖母弟）", "year": 947, "note": "高祖事晋为河东节度使以旻为都指挥使；高祖即帝位以为太原尹北京留守", "src": "新五代史·卷70"}, {"a": "耶律阿保机", "b": "耶律德光", "rel": "父子嗣位", "year": 926, "note": "阿保机卒葬木叶山，德光立改元天显", "src": "新五代史·卷72"}, {"a": "耶律阿保机", "b": "耶律突欲", "rel": "父子（东丹王）", "year": 926, "note": "灭渤海以突欲为东丹王；突欲让位于德光", "src": "新五代史·卷72"}, {"a": "耶律德光", "b": "述律后", "rel": "母子，国事必告", "year": 926, "note": "德光事其母甚谨，常侍立其侧，国事必告而后行；母召胡巫问吉凶", "src": "新五代史·卷72"}, {"a": "述律后", "b": "耶律李胡", "rel": "母子，欲立之", "year": 947, "note": "述律后爱李胡欲立，兀欲自立，战而胜之", "src": "新五代史·卷72"}, {"a": "耶律突欲", "b": "耶律兀欲", "rel": "父子", "year": 947, "note": "兀欲为突欲之子，德光卒后自立于镇阳", "src": "新五代史·卷72"}, {"a": "耶律德光", "b": "石敬瑭", "rel": "援立之为晋帝", "year": 936, "note": "敬瑭遣使求救，德光白其母曰「吾尝梦石郎召我」，乃许；灭唐立晋", "src": "新五代史·卷72"}, {"a": "耶律德光", "b": "王都", "rel": "遣兵救之", "year": 928, "note": "定州王都以蜡丸书走契丹求援，德光遣秃馁荝剌以骑五千救都，败于曲阳", "src": "新五代史·卷72"}, {"a": "秃馁", "b": "王晏球", "rel": "曲阳之败", "year": 928, "note": "都及秃馁击晏球于曲阳，为晏球所败", "src": "新五代史·卷72"}, {"a": "白承福", "b": "安重荣", "rel": "附之以归晋", "year": 940, "note": "吐浑白承福为契丹所迫，附镇州安重荣以归晋，重荣因请与契丹绝好", "src": "新五代史·卷74"}, {"a": "孔循", "b": "崔协", "rel": "力推其入相", "year": 929, "note": "循日言琪之短协之长，故重诲竟从之，协登庸之后庙堂代笔假手于人", "src": "旧五代史·卷58"}, {"a": "任圜", "b": "崔协", "rel": "斥其没字碑", "year": 929, "note": "圜奏曰「如崔协者，少识文字，时人谓之没字碑……何容中书之内更有笑端」", "src": "旧五代史·卷58"}, {"a": "任圜", "b": "李琪", "rel": "力荐其才而不得相", "year": 929, "note": "圜曰「朝廷有李琪者，学际天人……如弃苏合之丸取蛣蜣之转也」；重诲笑而止，终从循言", "src": "旧五代史·卷58"}, {"a": "郑珏", "b": "李琪", "rel": "素不协", "year": 928, "note": "郑珏素与琪不协，孔循亦恶琪", "src": "旧五代史·卷58"}, {"a": "王都", "b": "王建立", "rel": "遣人说其谋叛，建立伪许密以状闻", "year": 928, "note": "都阴知建立与重诲不协心怀怨嫉，乃遣人说建立谋叛", "src": "旧五代史·卷54"}, {"a": "王都", "b": "王晏球", "rel": "晏球讨之拔定州", "year": 929, "note": "制削都在身官爵，遣王晏球率师讨之；四年三月晏球拔定州，都巷战败纵火自焚", "src": "旧五代史·卷54"}, {"a": "丁会", "b": "李存勖", "rel": "以潞州归晋", "year": 903, "note": "会以潞州归河东，泣曰「汴王篡弱唐祚……今所谓吐盗父之食以见王也」，武皇纳之赐甲第于太原位在诸将上", "src": "旧五代史·卷59"}, {"a": "阎宝", "b": "胡规", "rel": "同自朱瑾部归汴", "year": 895, "note": "宝与胡规、康怀英归汴梁皆擢任之", "src": "旧五代史·卷59"}, {"a": "阎宝", "b": "葛从周", "rel": "同为大将统兵四出", "year": 895, "note": "宝与葛从周、丁会、贺德伦、李思安各为大将，统兵四出所至立功", "src": "旧五代史·卷59"}, {"a": "阎宝", "b": "庄宗", "rel": "胡柳陂谏止保营", "year": 918, "note": "宝进曰「王深入敌境偏师不利，王彦章骑军已入濮州」；庄宗耸听曰「微公几失计」", "src": "旧五代史·卷59"}, {"a": "王瓒", "b": "段凝", "rel": "凝奏族诛梁朝掌事权者", "year": 923, "note": "段凝上疏请诛首恶，张汉杰、张汉融、朱珪等并族诛家财籍没；瓒忧悸成疾", "src": "旧五代史·卷59"}, {"a": "袁象先", "b": "朱温", "rel": "甥舅（敬初娶梁祖之妹）", "year": 907, "note": "敬初娶梁祖之妹初封沛郡太君", "src": "旧五代史·卷59"}, {"a": "李袭吉", "b": "敬翔", "rel": "隔阵作书，词理相胜", "year": 904, "note": "袭吉为书贻梁祖至「毒手尊拳」句，梁祖令敬翔答之，翔词理非胜，袭吉之名愈重", "src": "旧五代史·卷60"}, {"a": "李袭吉", "b": "李存勖", "rel": "武皇幕府掌书记十五年", "year": 904, "note": "武皇遇难上源记室殁焉，袭吉访旧至太原召试称旨即署掌书记", "src": "旧五代史·卷60"}, {"a": "王缄", "b": "马郁", "rel": "郁以吏职事缄而讥其骤达", "year": 910, "note": "郁在太原谓缄曰「公在此作文士，所谓避风之鸟受赐于鲁人也」", "src": "旧五代史·卷60"}, {"a": "霍彦威", "b": "霍存", "rel": "养父子", "year": 905, "note": "梁将霍存得之于村落间年十四从征讨，存怜其爽迈养为己子", "src": "旧五代史·卷64"}, {"a": "霍彦威", "b": "王元信", "rel": "元信每戏侮彦威不敢答", "year": 926, "note": "元信恃功每对明宗以成败勇怯戏侮彦威不敢答；明宗曰成由天地不由于人", "src": "旧五代史·卷64"}, {"a": "石君立", "b": "李嗣昭", "rel": "为前锋", "year": 900, "note": "嗣昭每出征俾君立为前锋，敌人畏之", "src": "旧五代史·卷65"}, {"a": "石君立", "b": "王檀", "rel": "解晋阳之围", "year": 922, "note": "王檀之逼晋阳城中无备，君立率五百骑朝发暮至驰突斩击出入如神，梁军败走", "src": "旧五代史·卷65"}, {"a": "高行珪", "b": "高行周", "rel": "兄弟", "year": 900, "note": "家世勇悍与弟行周俱有武艺；行珪遣弟行周告急于周德威", "src": "旧五代史·卷65"}, {"a": "范延策", "b": "高行珪", "rel": "强谏不从，诬奏俱戮", "year": 932, "note": "延策睹行珪贪猥因强谏之，行珪不从；后诬奏延策同谋父子俱戮于汴闻者冤之", "src": "旧五代史·卷65"}, {"a": "段凝", "b": "王彦章", "rel": "用彦章代戴思远后继任招讨使", "year": 923, "note": "用王彦章代之受任之翌日取德胜之南城军声大振；后凝继彦章为招讨使", "src": "旧五代史·卷73"}, {"a": "段凝", "b": "李思安", "rel": "相州刺史李思安迎奉疏怠被贬，凝反以忠勤受赏", "year": 911, "note": "制云「怀州刺史段明远……观明远之忠勤若此，见思安之悖慢何如」", "src": "旧五代史·卷73"}, {"a": "康延孝", "b": "郭崇韬", "rel": "先见崇韬尽得梁虚实", "year": 923, "note": "康延孝自梁奔唐先见崇韬，崇韬延之卧内尽得梁虚实", "src": "旧五代史·卷24、卷74"}, {"a": "康延孝", "b": "孟知祥", "rel": "反，为孟知祥兵所败被擒", "year": 927, "note": "继岌遣圜将三千人会董璋孟知祥等兵击败延孝于汉州", "src": "旧五代史·卷74"}, {"a": "张虔钊", "b": "孙汉韶", "rel": "俱送款于蜀", "year": 934, "note": "西师俱变虔钊退归兴元，因与洋州节度使孙汉韶俱送款于蜀", "src": "旧五代史·卷74"}, {"a": "曹廷隐", "b": "贺德伦", "rel": "奉德伦命西迎庄宗", "year": 923, "note": "贺德伦使西迎庄宗于晋阳，庄宗既得邺城擢为马步都虞候", "src": "旧五代史·卷71"}, {"a": "谢瞳", "b": "朱温", "rel": "劝太祖戮伪监军使、悉众归唐", "year": 882, "note": "瞳揣太祖有择福意，进言劝归唐；翌日定策，戮伪监军使，悉众归", "src": "旧五代史·卷20"}, {"a": "谢瞳", "b": "王重荣", "rel": "表为检校屯田员外郎，奉表于蜀", "year": 883, "note": "王重荣表瞳为检校屯田员外郎，赐绯，令奉表于蜀", "src": "旧五代史·卷20"}, {"a": "刘捍", "b": "朱温", "rel": "亲军指挥、侍卫亲军都指挥使", "year": 901, "note": "太祖迎昭宗于岐下，以捍为亲军指挥；受禅后授侍卫亲军都指挥使", "src": "旧五代史·卷20"}, {"a": "刘捍", "b": "刘知俊", "rel": "为知俊部下所执", "year": 910, "note": "刘知俊据同州反，潜以厚利啖将校，捍遂为部下所执送知俊", "src": "旧五代史·卷20"}, {"a": "刘捍", "b": "李茂贞", "rel": "为李茂贞所害", "year": 911, "note": "知俊絷捍归于凤翔，为李茂贞所害", "src": "旧五代史·卷20"}, {"a": "王敬荛", "b": "朱温", "rel": "署为沿淮上下都指挥使，真拜武宁军节度使", "year": 895, "note": "乾宁二年署沿淮上下都指挥使，数月真拜武宁军节度使", "src": "旧五代史·卷20"}, {"a": "高劭", "b": "高骈", "rel": "从子（年十四遥领华州刺史）", "year": 879, "note": "淮南节度使骈之从子，以骈故早官", "src": "旧五代史·卷20"}, {"a": "高劭", "b": "朱温", "rel": "辟为宣武军节度判官", "year": 893, "note": "太祖以客礼遇之，表亳州团练副使，又数年辟为宣武军节度判官", "src": "旧五代史·卷20"}, {"a": "符道昭", "b": "秦宗权", "rel": "心膂，监督诸军", "year": 885, "note": "秦宗权用为心膂，使监督诸军，后为骑将", "src": "旧五代史·卷21"}, {"a": "符道昭", "b": "李茂贞", "rel": "养为己子，名继远", "year": 888, "note": "宋文通爱之，养为己子，名继远，遂易其宗", "src": "旧五代史·卷21"}, {"a": "符道昭", "b": "朱温", "rel": "来降，授秦州节度使、同平章事", "year": 895, "note": "道昭频领骑士敢斗战，屡为王师所败，遂来降；昭宗反正，奏授秦州节度使、同平章事", "src": "旧五代史·卷21"}, {"a": "徐怀玉", "b": "朱温", "rel": "太祖赐名怀玉", "year": 895, "note": "乾宁中奏加检校刑部尚书，太祖赐名怀玉", "src": "旧五代史·卷21"}, {"a": "刘𬩽", "b": "王师范", "rel": "为其马步军副都指挥使", "year": 887, "note": "师范以𬩽为马步军副都指挥使，攻下棣州，杀张蟾", "src": "旧五代史·卷23"}, {"a": "刘𬩽", "b": "葛从周", "rel": "袭兖州而礼其家，升堂拜母", "year": 903, "note": "时从周领兵在外，州城为𬩽所据，家属悉在城中；𬩽善抚其家，移就外第，供给有礼，升堂拜从周之母", "src": "旧五代史·卷23"}, {"a": "刘𬩽", "b": "朱温", "rel": "元从都押牙、开封尹", "year": 904, "note": "太祖嘉其节概，以为有李英公之风，旋授元从都押牙；后授开封尹", "src": "旧五代史·卷23"}, {"a": "李珽", "b": "李琪", "rel": "兄弟（同扶父丧）", "year": 880, "note": "家贫无以襄事，与弟琪当腊雪以单缞扶杖，衔哀告人，由是两克迁祔", "src": "旧五代史·卷24"}, {"a": "卢曾", "b": "朱温", "rel": "持檄往说王师范", "year": 889, "note": "太祖促召曾曰「子能缓颊说青州使无背盟，吾不负子矣」，曾持檄以往", "src": "旧五代史·卷24"}, {"a": "卢曾", "b": "王师范", "rel": "被囚送淮南遇害", "year": 889, "note": "既至青，师范囚之，送于淮南，遇害", "src": "旧五代史·卷24"}, {"a": "孙骘", "b": "公乘亿", "rel": "岳父，教以笺奏程式", "year": 886, "note": "魏博从事公乘亿以女妻之，因教以笺奏程式", "src": "旧五代史·卷24"}, {"a": "孙骘", "b": "朱温", "rel": "右谏议大夫，后格杀于白马顿", "year": 912, "note": "开平三年除右谏议大夫；乾化二年扈从后至，太祖大怒，格杀于前墀", "src": "旧五代史·卷24"}, {"a": "张俊", "b": "薛贻矩", "rel": "同年登第，奏为盐铁判官", "year": 907, "note": "太祖用宰臣薛贻矩为盐铁使，俊与贻矩同年登第，即奏为盐铁判官", "src": "旧五代史·卷24"}, {"a": "张俊", "b": "朱温", "rel": "礼部郎中，后同日遇祸", "year": 912, "note": "乾化二年二月扈从后至，与孙骘、张衍同日遇祸于白马顿", "src": "旧五代史·卷24"}, {"a": "张衍", "b": "张宗奭", "rel": "犹子（河南尹魏王宗奭之犹子）", "year": 895, "note": "父死于兵间，衍以宗奭勋力得官", "src": "旧五代史·卷24"}, {"a": "张衍", "b": "朱温", "rel": "翰林学士，罢为右谏议大夫，同日遇祸", "year": 912, "note": "太祖即位罢之，特拜考功郎中，俄迁右谏议大夫；乾化二年遇祸", "src": "旧五代史·卷24"}, {"a": "杜荀鹤", "b": "田𫖳", "rel": "田𫖳在宣州甚重之", "year": 891, "note": "时田𫖳在宣州，甚重之；𫖳将起兵，阴令以笺问至", "src": "旧五代史·卷24"}, {"a": "杜荀鹤", "b": "朱温", "rel": "表授翰林学士、主客员外郎", "year": 907, "note": "及𫖳遇祸，太祖以其才表之，寻授翰林学士、主客员外郎", "src": "旧五代史·卷24"}, {"a": "罗隐", "b": "钱镠", "rel": "辟为从事，典军中书檄", "year": 880, "note": "唐广明中因乱归乡里，节度使钱镠辟为从事", "src": "旧五代史·卷24"}, {"a": "罗隐", "b": "罗绍威", "rel": "密表推荐，致书称叔父", "year": 908, "note": "魏博节度使罗绍威密表推荐，乃授给事中；隐贻书叙家世，邺王为侄", "src": "旧五代史·卷24"}, {"a": "康君立", "b": "李克用", "rel": "推为大同军防御留后，为左都押牙", "year": 883, "note": "君立等夜谒武皇劝举事，既收城，推武皇为大同军防御留后", "src": "旧五代史·卷55"}, {"a": "康君立", "b": "李罕之", "rel": "帅师二万助攻河阳", "year": 888, "note": "李罕之失河阳来归，以君立充南面招讨使，帅师二万助之", "src": "旧五代史·卷55"}, {"a": "康君立", "b": "李存孝", "rel": "奉命讨之", "year": 893, "note": "李存孝据邢州叛，武皇命君立讨之，以功加检校太保", "src": "旧五代史·卷55"}, {"a": "张全义", "b": "诸葛爽", "rel": "依之，表为泽州刺史", "year": 883, "note": "巢败，依诸葛爽于河阳，累迁至裨校，爽表为泽州刺史", "src": "旧五代史·卷63"}, {"a": "张全义", "b": "李罕之", "rel": "同盟结义而后相攻，袭取河阳", "year": 888, "note": "与罕之同盟结义，据怀州乞师武皇；后乘其无备袭取河阳", "src": "旧五代史·卷63"}, {"a": "张全义", "b": "朱温", "rel": "河南尹、魏王，梁祖欲杀者数四", "year": 907, "note": "梁祖建号，兼河阳节度使，封魏王；梁祖猜忌，前后欲杀之者数四，夫人储氏面请得免", "src": "旧五代史·卷63"}, {"a": "张全义", "b": "李存勖", "rel": "复名全义，授尚书令、改封齐王", "year": 923, "note": "庄宗定河南，复名全义；制以全义复为尚书令、魏王、河南尹，明年改封齐王", "src": "旧五代史·卷63"}, {"a": "元行钦", "b": "刘守光", "rel": "爱将，奉命杀诸兄弟", "year": 908, "note": "守光之夺父位也，令行钦攻大恩山，又令杀诸兄弟", "src": "旧五代史·卷70"}, {"a": "元行钦", "b": "李嗣源", "rel": "降之，奏隶为假子", "year": 911, "note": "明宗怜其有勇，奏隶为假子，后因从征讨，恩礼特隆", "src": "旧五代史·卷70"}, {"a": "元行钦", "b": "李存勖", "rel": "赐姓名绍荣，宠冠诸将", "year": 916, "note": "命行钦为都部署，赐姓名绍荣；单骑解围，自是宠冠诸将", "src": "旧五代史·卷70"}, {"a": "马郁", "b": "李克用", "rel": "入武皇幕，累官秘书监", "year": 900, "note": "郁在武皇幕，累官至检校司空、秘书监，竟卒于太原", "src": "旧五代史·卷71"}, {"a": "赵在礼", "b": "刘仁恭", "rel": "始事之为小校", "year": 895, "note": "在礼始事燕帅刘仁恭为小校，仁恭遣子守文据沧州，升在礼为军使", "src": "旧五代史·卷90"}, {"a": "赵在礼", "b": "皇甫晖", "rel": "兵变被推为帅", "year": 926, "note": "军士皇甫晖等作乱，推指挥使杨晸为帅，晸不从被害，携首以胁在礼", "src": "旧五代史·卷90"}, {"a": "赵在礼", "b": "石敬瑭", "rel": "移镇郓州，封卫国公", "year": 936, "note": "高祖登极，移镇郓州，加检校太师、兼侍中，封卫国公", "src": "旧五代史·卷90"}, {"a": "安重荣", "b": "安重诲", "rel": "阴护之，免于死", "year": 932, "note": "高行周为帅欲杀之，其母赴阙申告，枢密使安重诲阴护之", "src": "旧五代史·卷98"}, {"a": "安重荣", "b": "石敬瑭", "rel": "授成德军节度使，后起兵反晋", "year": 936, "note": "及即位，授成德军节度使，累加至使相；后畜聚亡命、收市战马，有飞扬跋扈之志", "src": "旧五代史·卷98"}, {"a": "史宏肇", "b": "刘知远", "rel": "亲从、侍卫亲军都指挥使", "year": 947, "note": "尝在晋祖麾下留为亲从；高祖建号，授许州节度使、侍卫步军都指挥使", "src": "旧五代史·卷107"}, {"a": "史宏肇", "b": "李崧", "rel": "族戮于市，取其幼女为婢", "year": 948, "note": "故相李崧为部曲诬告，族戮于市，取其幼女为婢", "src": "旧五代史·卷107"}, {"a": "李崧", "b": "桑维翰", "rel": "并兼枢密使", "year": 936, "note": "拜中书侍郎、同平章事，与桑维翰并兼枢密使", "src": "旧五代史·卷108"}, {"a": "李崧", "b": "苏逢吉", "rel": "为逢吉所构，举家遇害", "year": 948, "note": "逢吉遣吏召崧至第，崧以幼女为托，逢吉遣吏送于侍卫狱，举家遇害", "src": "旧五代史·卷108"}, {"a": "杜重威", "b": "李嗣源", "rel": "少事之，自护圣军校领刺史", "year": 926, "note": "重威少事明宗，自护圣军校领防州刺史", "src": "旧五代史·卷109"}, {"a": "杜重威", "b": "石敬瑭", "rel": "典禁军、破安重荣，授成德军节度使", "year": 940, "note": "晋高祖遣重威破张从宾，后拔常山斩安重荣首，授成德军节度使", "src": "旧五代史·卷109"}, {"a": "杜重威", "b": "安重荣", "rel": "拔其城，斩首传于阙下", "year": 942, "note": "重荣奔据常山，重威寻拔其城，斩重荣首传于阙下", "src": "旧五代史·卷109"}, {"a": "杜重威", "b": "契丹", "rel": "连署降表，举军降敌", "year": 946, "note": "伏甲于内，召诸将会，告以降敌之意，诸将连署降表，军士解甲恸哭", "src": "旧五代史·卷109"}, {"a": "高行周", "b": "高思继", "rel": "父子，昆仲分掌燕兵", "year": 900, "note": "以思继兄为先锋都将、思继为中军都将、思继弟为后军都将，昆仲分掌燕兵", "src": "旧五代史·卷123"}, {"a": "高行周", "b": "李嗣源", "rel": "为其前锋", "year": 915, "note": "明宗之袭郓州也，行周为前锋", "src": "旧五代史·卷123"}, {"a": "高行周", "b": "石敬瑭", "rel": "加同平章事，为西京留守", "year": 936, "note": "晋祖入洛，令行周还藩，加同平章事；都汴，以为西京留守", "src": "旧五代史·卷123"}, {"a": "高行周", "b": "符彦卿", "rel": "左右排阵使", "year": 936, "note": "唐末帝命张敬达征晋阳，行周与符彦卿为左右排阵使", "src": "旧五代史·卷123"}, {"a": "冯道", "b": "刘守光", "rel": "署为幽州掾，怒而囚之", "year": 907, "note": "守光引兵伐中山，访于僚属，道以利害箴之，守光怒，置于狱中", "src": "旧五代史·卷126"}, {"a": "冯道", "b": "张承业", "rel": "辟为本院巡官，荐为霸府从事", "year": 913, "note": "守光败，遁归太原，监军使张承业辟为本院巡官，寻荐为霸府从事", "src": "旧五代史·卷126"}, {"a": "冯道", "b": "李存勖", "rel": "署太原掌书记，文翰一以委之", "year": 916, "note": "时庄宗并有河北，文翰甚繁，一以委之", "src": "旧五代史·卷126"}, {"a": "冯道", "b": "李嗣源", "rel": "拜端明殿学士，迁平章事", "year": 926, "note": "俄拜端明殿学士，端明之号自道始；未几迁中书侍郎、刑部尚书、平章事", "src": "旧五代史·卷126"}, {"a": "李茂贞", "b": "郑畋", "rel": "遣之败尚让于龙尾坡", "year": 880, "note": "郑畋理兵于岐下，遣文通以本军败尚让之众于龙尾坡", "src": "旧五代史·卷132"}, {"a": "李茂贞", "b": "唐僖宗", "rel": "赐姓名茂贞，亲制字曰正臣", "year": 885, "note": "文通扈跸山南，论功第一，赐姓名茂贞，僖宗亲为制字曰正臣", "src": "旧五代史·卷132"}, {"a": "李茂贞", "b": "杜让能", "rel": "败其师，迫朝廷诛之", "year": 894, "note": "命宰臣杜让能调发军旅，师未越境为茂贞所败；茂贞抗言让能之罪，诛之方罢", "src": "旧五代史·卷132"}, {"a": "李茂贞", "b": "王行瑜", "rel": "同称兵入觐，京师震恐", "year": 895, "note": "茂贞与王行瑜、韩建称兵入觐，抗表请杀宰相韦昭度、李谿", "src": "旧五代史·卷132"}, {"a": "李茂贞", "b": "王建", "rel": "山南诸州尽为王建所陷", "year": 903, "note": "茂贞山南诸州尽为王建所陷，泾原秦陇邠鄜延夏皆降于汴", "src": "旧五代史·卷132"}, {"a": "朱瑄", "b": "朱温", "rel": "先连衡后相攻，郓州破被擒杀", "year": 897, "note": "太祖并兵以攻郓，自景福元年至乾宁三年大小数十战，郓州破，瑄被擒杀", "src": "旧五代史·卷13"}, {"a": "朱瑄", "b": "朱瑾", "rel": "从兄弟，郓兖相援", "year": 890, "note": "瑾为瑄从弟，郓、兖相邻，互为唇齿", "src": "旧五代史·卷13"}, {"a": "朱瑾", "b": "杨行密", "rel": "表领徐州节度使", "year": 897, "note": "瑾无归路，保海州，行密表瑾领徐州节度使", "src": "旧五代史·卷13"}, {"a": "朱瑾", "b": "徐知训", "rel": "为其所杀", "year": 918, "note": "知训与瑾有隙，夜遣壮士杀瑾，瑾手刃数人", "src": "旧五代史·卷13"}, {"a": "罗弘信", "b": "乐彦贞", "rel": "初为马牧监，事之", "year": 880, "note": "宏信本名宗弁，初为马牧监，事节度使乐彦贞", "src": "旧五代史·卷14"}, {"a": "罗弘信", "b": "朱温", "rel": "兄弟之国，对魏使北面拜受", "year": 898, "note": "太祖每有答贶，必对魏使北面拜而受之，曰「六兄比予有倍年之长，兄弟之国」", "src": "旧五代史·卷14"}, {"a": "罗绍威", "b": "罗弘信", "rel": "父子，袭位为留后", "year": 898, "note": "绍威袭父位为留后，朝廷因而命之，寻正授旄钺", "src": "旧五代史·卷14"}, {"a": "罗绍威", "b": "朱温", "rel": "感援助之恩，尽诛牙军", "year": 905, "note": "绍威率奴客数百与马嗣勋同攻牙军，迟明尽诛之，凡八千家皆赤其族", "src": "旧五代史·卷14"}, {"a": "韩建", "b": "田令孜", "rel": "补为神策都校", "year": 883, "note": "田令孜密遣人诱建，建率所部归行在，令孜补为神策都校、金吾将军", "src": "旧五代史·卷15"}, {"a": "韩建", "b": "李巨川", "rel": "从事，太祖诛之", "year": 901, "note": "建拜伏称从事李巨川之谋，太祖即诛巨川", "src": "旧五代史·卷15"}, {"a": "韩建", "b": "朱温", "rel": "军中昆弟之契，表为许州节度使", "year": 901, "note": "太祖与建素有军中昆弟之契，及见，其怒骤息，寻表建为许州节度使", "src": "旧五代史·卷15"}, {"a": "成汭", "b": "杨行密", "rel": "围鄂州，汭援鄂败死", "year": 903, "note": "杨行密以兵围鄂州，汭出师以援鄂，淮寇乘之，以火焚其舰，汭投江而死", "src": "旧五代史·卷17"}, {"a": "张文蔚", "b": "裴坦", "rel": "判盐铁，署为巡官", "year": 875, "note": "唐乾符初登进士第，时丞相裴坦兼判盐铁，解褐署巡官", "src": "旧五代史·卷18"}, {"a": "张文蔚", "b": "柳璨", "rel": "同相，璨擅权纵暴", "year": 905, "note": "时柳璨在相位，擅权纵暴，倾陷贤俊，裴枢等五家及三省而下三十余人咸抱冤就死", "src": "旧五代史·卷18"}, {"a": "赵光逢", "b": "柳璨", "rel": "光化二年放璨及第", "year": 899, "note": "光化二年，赵光逢放柳璨及第", "src": "旧五代史·卷58"}, {"a": "赵光逢", "b": "赵光允", "rel": "兄弟，同为平章事", "year": 925, "note": "同光初，弟光允为平章事，时谒问于私第", "src": "旧五代史·卷58"}, {"a": "薛廷珪", "b": "朱温", "rel": "官告使至汴，不肯加礼", "year": 901, "note": "朱全忠兼四镇，廷珪以官告使至汴，客将讽其拜，廷珪佯不晓，卒不肯加礼", "src": "旧五代史·卷68"}, {"a": "薛廷珪", "b": "唐昭宗", "rel": "迁洛阳，征为礼部侍郎", "year": 904, "note": "昭宗迁洛阳，征为礼部侍郎", "src": "旧五代史·卷68"}, {"a": "房知温", "b": "刘知俊", "rel": "补为克和军使", "year": 890, "note": "𬩽降，隶于同州刘知俊，知俊补为克和军使", "src": "旧五代史·卷91"}, {"a": "房知温", "b": "杨师厚", "rel": "马步军校至亲随指挥使", "year": 897, "note": "知俊奔岐，改隶魏州杨师厚，以为马步军校，渐升至亲随指挥使", "src": "旧五代史·卷91"}, {"a": "房知温", "b": "李存勖", "rel": "赐姓名绍英", "year": 915, "note": "庄宗入魏，赐姓，名绍英，改天雄军马步都指挥使", "src": "旧五代史·卷91"}, {"a": "房知温", "b": "李嗣源", "rel": "署滑州留后，授兖州节度使", "year": 926, "note": "明宗自总管府署知温滑州两使留后；天成元年授兖州节度使", "src": "旧五代史·卷91"}, {"a": "苌从简", "b": "李存勖", "rel": "帐前亲卫，夺帜而还", "year": 917, "note": "从简潜领十数骑挺身而入，夺帜以归，万众鼓噪，庄宗壮之", "src": "旧五代史·卷94"}, {"a": "苌从简", "b": "石敬瑭", "rel": "充副招讨使，除河阳节度使", "year": 936, "note": "高祖举义，末帝诏赴阙，充副招讨使，随驾至孟津，除河阳节度使", "src": "旧五代史·卷94"}, {"a": "皇甫遇", "b": "杜重威", "rel": "从营滹水，重威降契丹", "year": 946, "note": "四年契丹复至，从杜重威营滹水，重威送款于契丹，遇不预其议，及降心不平之", "src": "旧五代史·卷95"}, {"a": "皇甫遇", "b": "杜知敏", "rel": "以马授遇，遇救之还", "year": 944, "note": "遇所乘马中镝而毙，杜知敏以马授遇；知敏为敌所获，遇与彦超跃马取之而还", "src": "旧五代史·卷95"}, {"a": "范延光", "b": "李存勖", "rel": "以蜡书达机事，授官", "year": 923, "note": "明宗欲使人达机事于庄宗，方难其选，延光请行，遂以蜡书授之；庄宗喜，授银青光禄大夫、检校工部尚书", "src": "旧五代史·卷97"}, {"a": "范延光", "b": "安重诲", "rel": "安重诲得罪，延光再入枢密", "year": 930, "note": "长兴中，以安重诲得罪，再入为枢密使，加同平章事", "src": "旧五代史·卷97"}, {"a": "范延光", "b": "石敬瑭", "rel": "封临清王，后为高祖所疑", "year": 936, "note": "高祖入洛，寻封临清王，以宽其反侧；后延光聚兵部下，高祖甚疑之", "src": "旧五代史·卷97"}, {"a": "王峻", "b": "刘知远", "rel": "授客省使，奉使荆南", "year": 947, "note": "汉祖践阼，授客省使，奉使荆南，留于襄、汉为监军", "src": "旧五代史·卷130"}, {"a": "王峻", "b": "郭威", "rel": "监军、门下侍郎平章事", "year": 951, "note": "太祖镇邺，峻为监军；太祖践阼，加平章事，寻兼右仆射、门下侍郎平章事", "src": "旧五代史·卷130"}]
