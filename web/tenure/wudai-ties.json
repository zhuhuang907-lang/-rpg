[{"a": "李克用", "b": "李嗣昭", "rel": "养父（命弟克柔养为子，赐名）", "year": 890, "note": "出猎汾州见林中有气，遗金帛取其儿", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李嗣本", "rel": "养父（赐姓名）", "year": 890, "note": "嗣本少事太祖，爱之养为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李嗣恩", "rel": "养父（赐姓名）", "year": 890, "note": "为铁林军将，稍以战功赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存信", "rel": "养父（赐姓名）", "year": 880, "note": "从起代北入关破黄巢，遂赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存孝", "rel": "养父（赐姓名）", "year": 886, "note": "掠地代北得之，给事帐中赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存进", "rel": "养父（赐姓名）", "year": 883, "note": "攻破朔州得之，赐姓名养为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存璋", "rel": "义儿（受顾命）", "year": 908, "note": "太祖病革，璋与张承业等受顾命立庄宗", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存贤", "rel": "养父（赐姓名）", "year": 883, "note": "击黄巢于陈州得之，赐姓名养为子", "src": "新五代史·卷36"}, {"a": "李存信", "b": "李存孝", "rel": "交恶进谗", "year": 892, "note": "存信谮存孝有二心常避赵不击，存孝遂附梁反晋", "src": "新五代史·卷36"}, {"a": "康君立", "b": "李存信", "rel": "相善左袒", "year": 892, "note": "君立每左右存信以倾存孝", "src": "新五代史·卷36"}, {"a": "李克用", "b": "康君立", "rel": "怒而鸩杀", "year": 894, "note": "语及存孝流涕，君立以为不然，太祖怒鸖杀之", "src": "新五代史·卷36"}, {"a": "李嗣昭", "b": "李继韬", "rel": "父子（继韬囚兄自立）", "year": 922, "note": "嗣昭卒，继韬囚长兄继俦以自立，后伏诛", "src": "新五代史·卷36"}, {"a": "周匝", "b": "陈俊", "rel": "乞恩报德", "year": 926, "note": "周匝谓身陷仇人不死，赖俊与德源之力，请除二州刺史", "src": "新五代史·卷37"}, {"a": "周匝", "b": "储德源", "rel": "乞恩报德", "year": 926, "note": "同上，卒以俊为景州刺史、德源为宪州刺史", "src": "新五代史·卷37"}, {"a": "贺瓌", "b": "谢彦章", "rel": "忌而伏甲杀之", "year": 918, "note": "瓌疑彦章以营地告晋，使朱珪诬其将反而杀之；庄宗喜曰：将帅不和，梁亡无日矣", "src": "新五代史·卷23"}, {"a": "郭崇韬", "b": "罗贯", "rel": "知遇而救不得", "year": 925, "note": "贯为崇韬所知，坤陵桥道之狱崇韬谏「罪不当死」，庄宗怒阖殿门，贯卒见杀", "src": "新五代史·卷24"}, {"a": "安重诲", "b": "杨彦温", "rel": "阴图潞王使叛", "year": 931, "note": "重诲以从珂非李氏子后必为患；彦温闭城自言得枢密院宣；事败彦温被斩灭口", "src": "新五代史·卷24"}, {"a": "韩玫", "b": "乌昭遇", "rel": "辱使而返谮", "year": 931, "note": "玫恃重诲势醉以马箠击昭遇，还谮其舞蹈称臣私告镠，昭遇坐死御史狱", "src": "新五代史·卷24"}, {"a": "周德威", "b": "李嗣昭", "rel": "素有隙，破夹城后欢如初", "year": 908, "note": "晋王病革忧之；德威闻丧即日还军太原，伏梓宫恸哭几绝，晋人乃安", "src": "新五代史·卷25"}, {"a": "周德威", "b": "王景仁", "rel": "柏乡大破之", "year": 911, "note": "德威退军鄗邑诱敌，至未申鼓噪而进，梁阵动皆走，横尸数十里", "src": "新五代史·卷25"}, {"a": "符存审", "b": "郭崇韬", "rel": "名望相轧，沮其来朝", "year": 924, "note": "崇韬不乐存审来加己上，其妻郭氏泣诉亦怒；崇韬度其病亟乃请许来朝", "src": "新五代史·卷25"}, {"a": "符存审", "b": "李嗣昭", "rel": "同救河中朱友谦", "year": 916, "note": "存审选精骑二百杂河中兵阳败诱𬩽，反击获其骑五十，按军伺隙大败刘𬩽", "src": "新五代史·卷25"}, {"a": "符存审", "b": "符彦超", "rel": "父子", "year": 924, "note": "存审三子彦超、彦饶、彦卿皆显", "src": "新五代史·卷25"}, {"a": "符彦超", "b": "符彦饶", "rel": "兄弟", "year": 926, "note": "彦超巡检北京杀存霸；彦饶汴州诛谏；皆存审子", "src": "新五代史·卷25"}, {"a": "符存审", "b": "史建瑭", "rel": "同守赵州拒梁太祖", "year": 912, "note": "存审扼下博桥，建瑭五队掠梁刍牧、百骑夜叩梁营，梁太祖夜拔营去", "src": "新五代史·卷25"}, {"a": "李建及", "b": "贺瓌", "rel": "德胜南城之战胜之", "year": 916, "note": "瓌以竹笮维战舰，建及以大瓮积薪上流纵火，斧其竹笮，梁兵皆走", "src": "新五代史·卷25"}, {"a": "孔谦", "b": "郭崇韬", "rel": "求为租庸使不得，怨而斗", "year": 923, "note": "崇韬用张宪为租庸使以谦为副，谦怏怏；又倡罢宪以正言代之", "src": "新五代史·卷26"}, {"a": "孔谦", "b": "景进", "rel": "赖其救解", "year": 924, "note": "谦求解职，庄宗怒欲寘之法，赖伶官景进救解乃止；后景进数以为言罢正言而谦为租庸使", "src": "新五代史·卷26"}, {"a": "孔谦", "b": "王正言", "rel": "排宪而立之，继而不相能", "year": 924, "note": "谦谓「邺都天下之重不可轻以任人」罢宪，以正言为租庸使；正言病风不任事，谦遂得其位", "src": "新五代史·卷26"}, {"a": "李仁矩", "b": "安重诲", "rel": "亲信而委以制璋", "year": 929, "note": "仁矩素为重诲亲信；重诲分阆州为保宁军以仁矩为节度使以制董璋，璋反攻阆州，仁矩被擒家属皆见杀", "src": "新五代史·卷26"}]