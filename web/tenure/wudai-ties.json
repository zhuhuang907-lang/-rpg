[{"a": "李克用", "b": "李嗣昭", "rel": "养父（命弟克柔养为子，赐名）", "year": 890, "note": "出猎汾州见林中有气，遗金帛取其儿", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李嗣本", "rel": "养父（赐姓名）", "year": 890, "note": "嗣本少事太祖，爱之养为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李嗣恩", "rel": "养父（赐姓名）", "year": 890, "note": "为铁林军将，稍以战功赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存信", "rel": "养父（赐姓名）", "year": 880, "note": "从起代北入关破黄巢，遂赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存孝", "rel": "养父（赐姓名）", "year": 886, "note": "掠地代北得之，给事帐中赐姓名以为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存进", "rel": "养父（赐姓名）", "year": 883, "note": "攻破朔州得之，赐姓名养为子", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存璋", "rel": "义儿（受顾命）", "year": 908, "note": "太祖病革，璋与张承业等受顾命立庄宗", "src": "新五代史·卷36"}, {"a": "李克用", "b": "李存贤", "rel": "养父（赐姓名）", "year": 883, "note": "击黄巢于陈州得之，赐姓名养为子", "src": "新五代史·卷36"}, {"a": "李存信", "b": "李存孝", "rel": "交恶进谗", "year": 892, "note": "存信谮存孝有二心常避赵不击，存孝遂附梁反晋", "src": "新五代史·卷36"}, {"a": "康君立", "b": "李存信", "rel": "相善左袒", "year": 892, "note": "君立每左右存信以倾存孝", "src": "新五代史·卷36"}, {"a": "李克用", "b": "康君立", "rel": "怒而鸩杀", "year": 894, "note": "语及存孝流涕，君立以为不然，太祖怒鸖杀之", "src": "新五代史·卷36"}, {"a": "李嗣昭", "b": "李继韬", "rel": "父子（继韬囚兄自立）", "year": 922, "note": "嗣昭卒，继韬囚长兄继俦以自立，后伏诛", "src": "新五代史·卷36"}, {"a": "周匝", "b": "陈俊", "rel": "乞恩报德", "year": 926, "note": "周匝谓身陷仇人不死，赖俊与德源之力，请除二州刺史", "src": "新五代史·卷37"}, {"a": "周匝", "b": "储德源", "rel": "乞恩报德", "year": 926, "note": "同上，卒以俊为景州刺史、德源为宪州刺史", "src": "新五代史·卷37"}, {"a": "贺瓌", "b": "谢彦章", "rel": "忌而伏甲杀之", "year": 918, "note": "瓌疑彦章以营地告晋，使朱珪诬其将反而杀之；庄宗喜曰：将帅不和，梁亡无日矣", "src": "新五代史·卷23"}, {"a": "郭崇韬", "b": "罗贯", "rel": "知遇而救不得", "year": 925, "note": "贯为崇韬所知，坤陵桥道之狱崇韬谏「罪不当死」，庄宗怒阖殿门，贯卒见杀", "src": "新五代史·卷24"}, {"a": "安重诲", "b": "杨彦温", "rel": "阴图潞王使叛", "year": 931, "note": "重诲以从珂非李氏子后必为患；彦温闭城自言得枢密院宣；事败彦温被斩灭口", "src": "新五代史·卷24"}, {"a": "韩玫", "b": "乌昭遇", "rel": "辱使而返谮", "year": 931, "note": "玫恃重诲势醉以马箠击昭遇，还谮其舞蹈称臣私告镠，昭遇坐死御史狱", "src": "新五代史·卷24"}, {"a": "周德威", "b": "李嗣昭", "rel": "素有隙，破夹城后欢如初", "year": 908, "note": "晋王病革忧之；德威闻丧即日还军太原，伏梓宫恸哭几绝，晋人乃安", "src": "新五代史·卷25"}, {"a": "周德威", "b": "王景仁", "rel": "柏乡大破之", "year": 911, "note": "德威退军鄗邑诱敌，至未申鼓噪而进，梁阵动皆走，横尸数十里", "src": "新五代史·卷25"}, {"a": "符存审", "b": "郭崇韬", "rel": "名望相轧，沮其来朝", "year": 924, "note": "崇韬不乐存审来加己上，其妻郭氏泣诉亦怒；崇韬度其病亟乃请许来朝", "src": "新五代史·卷25"}, {"a": "符存审", "b": "李嗣昭", "rel": "同救河中朱友谦", "year": 916, "note": "存审选精骑二百杂河中兵阳败诱𬩽，反击获其骑五十，按军伺隙大败刘𬩽", "src": "新五代史·卷25"}, {"a": "符存审", "b": "符彦超", "rel": "父子", "year": 924, "note": "存审三子彦超、彦饶、彦卿皆显", "src": "新五代史·卷25"}, {"a": "符彦超", "b": "符彦饶", "rel": "兄弟", "year": 926, "note": "彦超巡检北京杀存霸；彦饶汴州诛谏；皆存审子", "src": "新五代史·卷25"}, {"a": "符存审", "b": "史建瑭", "rel": "同守赵州拒梁太祖", "year": 912, "note": "存审扼下博桥，建瑭五队掠梁刍牧、百骑夜叩梁营，梁太祖夜拔营去", "src": "新五代史·卷25"}, {"a": "李建及", "b": "贺瓌", "rel": "德胜南城之战胜之", "year": 916, "note": "瓌以竹笮维战舰，建及以大瓮积薪上流纵火，斧其竹笮，梁兵皆走", "src": "新五代史·卷25"}, {"a": "孔谦", "b": "郭崇韬", "rel": "求为租庸使不得，怨而斗", "year": 923, "note": "崇韬用张宪为租庸使以谦为副，谦怏怏；又倡罢宪以正言代之", "src": "新五代史·卷26"}, {"a": "孔谦", "b": "景进", "rel": "赖其救解", "year": 924, "note": "谦求解职，庄宗怒欲寘之法，赖伶官景进救解乃止；后景进数以为言罢正言而谦为租庸使", "src": "新五代史·卷26"}, {"a": "孔谦", "b": "王正言", "rel": "排宪而立之，继而不相能", "year": 924, "note": "谦谓「邺都天下之重不可轻以任人」罢宪，以正言为租庸使；正言病风不任事，谦遂得其位", "src": "新五代史·卷26"}, {"a": "李仁矩", "b": "安重诲", "rel": "亲信而委以制璋", "year": 929, "note": "仁矩素为重诲亲信；重诲分阆州为保宁军以仁矩为节度使以制董璋，璋反攻阆州，仁矩被擒家属皆见杀", "src": "新五代史·卷26"}, {"a": "朱弘昭", "b": "安重诲", "rel": "谗构致其死", "year": 932, "note": "弘昭迎谒礼甚恭，酒酣得重诲怨望之言即奏之，又驰告敬瑭拒重诲；重诲过凤翔，闭门不纳，由此得罪死", "src": "新五代史·卷27"}, {"a": "朱弘昭", "b": "冯赟", "rel": "并掌机务，同日俱死", "year": 933, "note": "代延寿延光秉枢密；汉琼、王淑妃用事，大事皆决此四人；从珂兵东，弘昭投井，从进杀赟", "src": "新五代史·卷27"}, {"a": "康义诚", "b": "朱弘昭", "rel": "从荣案持两端相表里", "year": 933, "note": "弘昭等以反白明宗，涕泣召义诚使自处置，义诚卒不出兵", "src": "新五代史·卷27"}, {"a": "药彦稠", "b": "杨彦温", "rel": "希旨杀以灭口", "year": 931, "note": "明宗戒得彦温毋杀将讯之，彦稠希重诲旨杀彦温以灭口", "src": "新五代史·卷27"}, {"a": "药彦稠", "b": "安重诲", "rel": "希旨行事", "year": 931, "note": "矫诏遣彦温逐从珂本出重诲，彦稠杀之以灭口；明宗不之罪", "src": "新五代史·卷27"}, {"a": "豆卢革", "b": "韦说", "rel": "荐相相倚，俱贬死", "year": 924, "note": "革荐说「能知前朝事」；说教门人上书言崇韬事；二人各以其子为拾遗父子同省；俱为希甫诬奏贬死", "src": "新五代史·卷28"}, {"a": "萧希甫", "b": "豆卢革", "rel": "诬奏革纵田客杀人", "year": 926, "note": "希甫希重诲旨诬奏，有司推劾井中惟破釜，革说终皆贬死", "src": "新五代史·卷28"}, {"a": "萧希甫", "b": "韦说", "rel": "诬奏说与邻人争井", "year": 926, "note": "井有宝货之说，推劾惟破釜", "src": "新五代史·卷28"}, {"a": "卢程", "b": "任圜", "rel": "骂虫豸致庄宗趣令自尽", "year": 923, "note": "程帖兴唐府给驴夫笞吏背，圜诣诉，程骂「尔何虫豸，恃妇家力也」；庄宗怒「朕悮相此痴物」，卢质力解", "src": "新五代史·卷28"}, {"a": "任圜", "b": "安重诲", "rel": "争权交恶，矫制杀之", "year": 927, "note": "使臣给券之争、妓事之恶；守殷反，重诲诬圜与通谋，遣人矫制杀之，圜怡然聚族酣饮而死", "src": "新五代史·卷28"}, {"a": "赵凤", "b": "任圜", "rel": "素善荐进，杀之独号哭", "year": 927, "note": "凤自圜为相颇荐进之；圜被诬谋反，凤独号哭呼重诲曰「任圜天下义士，岂肯谋反！」重诲惭不能对", "src": "新五代史·卷28"}, {"a": "赵凤", "b": "安重诲", "rel": "手疏切责，败后独言其忠", "year": 929, "note": "罢幸邺手疏责重诲言甚切直；重诲得罪群臣无敢言者，独凤数言重诲尽忠，明宗以凤为朋党罢之", "src": "新五代史·卷28"}, {"a": "张宪", "b": "史彦琼", "rel": "库钱之诘，伶为之解", "year": 925, "note": "庄宗谓彦琼曰「我与群臣博须钱十余万，而宪以故纸绐我」，彦琼为宪解之乃已", "src": "新五代史·卷28"}, {"a": "张宪", "b": "符彦超", "rel": "存霸案牵连而死", "year": 926, "note": "存霸奔太原愿为僧求生，彦超麾下兵噪而杀之；宪出奔沂州亦见杀", "src": "新五代史·卷28"}, {"a": "朱弘昭", "b": "刘赞", "rel": "争免秦王属官之死", "year": 933, "note": "冯道议原减，弘昭曰「使秦王得入光政门，当待赞等如何」，赟亦争，赞等乃免死", "src": "新五代史·卷28"}, {"a": "桑维翰", "b": "景延广", "rel": "盟成于维翰败于延广", "year": 944, "note": "自契丹与晋盟始成于维翰而终败于延广；契丹书檄未尝不以两人为言", "src": "新五代史·卷29"}, {"a": "苏逢吉", "b": "史弘肇", "rel": "将相如水火", "year": 949, "note": "会王章第使酒，弘肇索剑欲追之，杨邠泣曰「苏公汉宰相，公若杀之致天子何地乎」；王峻置酒和解", "src": "新五代史·卷30"}, {"a": "史弘肇", "b": "杨邠", "rel": "同授顾命，同日族诛", "year": 950, "note": "与王章等入朝坐广政殿东庑，甲士自内出擒斩之，并族其三家", "src": "新五代史·卷30"}, {"a": "史弘肇", "b": "王章", "rel": "毛锥子之争", "year": 950, "note": "弘肇曰长枪大剑若毛锥子安足用哉；章曰无毛锥子军赋何从集乎，弘肇默然", "src": "新五代史·卷30"}, {"a": "苏逢吉", "b": "杨邠", "rel": "内相排忌", "year": 949, "note": "逢吉讽李涛上疏罢邠与周太祖枢密，邠泣诉李太后前，太后怒罢涛相，事悉关决", "src": "新五代史·卷30"}, {"a": "郭允明", "b": "杨邠", "rel": "手杀其诸子于朝堂", "year": 950, "note": "载邠等十余尸暴之市中，允明手杀邠等诸子于朝堂西庑，王章壻张贻肃血流逆注", "src": "新五代史·卷30"}, {"a": "后赞", "b": "张延朗", "rel": "幼善讴事延朗", "year": 944, "note": "延朗死赞更事汉高祖，以为牙将", "src": "新五代史·卷30"}, {"a": "王朴", "b": "杨邠", "rel": "见将相交恶去邠东归独免", "year": 948, "note": "朴依邠为校书郎，知其必乱乃去东归；后邠与章弘肇皆见杀三家之客多及而朴独免", "src": "新五代史·卷31"}, {"a": "王朴", "b": "扈载", "rel": "尤重其才力荐", "year": 956, "note": "朴荐载于李谷久不用，谷曰载命薄恐不能胜，朴曰「何言命邪」，已而召拜知制诰", "src": "新五代史·卷31"}, {"a": "王彦章", "b": "夏鲁奇", "rel": "同乡旧识，阵上擒之", "year": 923, "note": "鲁奇素与彦章善，识其语音曰「王铁枪也」，举矟刺之，彦章伤重马踣被擒", "src": "新五代史·卷33"}, {"a": "刘仁赡", "b": "孙晟", "rel": "同守寿州之局", "year": 956, "note": "孙晟使周留不遣，仁赡守寿州；二人皆以死节称", "src": "新五代史·卷32—33"}, {"a": "刘仁赡", "b": "刘彦贞", "rel": "谏其勿追，彦贞不听败于正阳", "year": 955, "note": "李谷退守正阳浮桥，彦贞意其怯急追之，仁赡以为不可，彦贞不听，果败", "src": "新五代史·卷32"}, {"a": "张承业", "b": "张居翰", "rel": "宦官两派，承业主藏居翰默默", "year": 923, "note": "居翰与郭崇韬并为枢密使，崇韬专任政，居翰默默苟免；承业主藏，庄宗求钱不可得", "src": "新五代史·卷38"}, {"a": "马绍宏", "b": "郭崇韬", "rel": "争枢密使之位结怨", "year": 923, "note": "二人俱为中门使而绍宏位在上；崇韬不欲绍宏在己上，乃以张居翰为枢密使，绍宏为宣徽使，失职怨望", "src": "新五代史·卷24、卷38"}, {"a": "孟汉琼", "b": "朱弘昭", "rel": "并掌机务，同陷秦王", "year": 933, "note": "弘昭等方图其事议未决，汉琼遽入见明宗言秦王反，即以兵诛之", "src": "新五代史·卷27、卷38"}, {"a": "张敬达", "b": "石敬瑭", "rel": "分其兵权致其反", "year": 936, "note": "废帝疑敬瑭有异志，以敬达为北面副总管分其兵；徙敬瑭镇天平，敬达为都部署，敬瑭因此遂反", "src": "新五代史·卷33"}, {"a": "王清", "b": "杜重威", "rel": "请战而主将不进，独死", "year": 946, "note": "清请以步兵二千夺桥开路，重威许之而犹豫不进，彦筠亦退，清曰「吾独死于此矣」力战而死", "src": "新五代史·卷33"}, {"a": "郑遨", "b": "李振", "rel": "故善，贵不仕，窜则千里往省", "year": 915, "note": "振事梁贵显欲以禄遨，遨不顾；振得罪南窜，遨徒步千里往省之，闻者益高其行", "src": "新五代史·卷34"}, {"a": "敬翔", "b": "李振", "rel": "并佐朱温倾唐，同列崇政院", "year": 907, "note": "昭宗还长安御延喜楼召翔与李振登楼劳问，翔授检校右仆射太府卿赐号迎銮协赞功臣；二人同倾唐祚", "src": "旧五代史·卷18"}, {"a": "李振", "b": "裴枢", "rel": "白马驿之谋，劝投清流于河", "year": 905, "note": "柳璨谮杀裴枢陆扆等七人于滑州白马驿，振谓太祖「此辈自谓清流，宜投于黄河，永为浊流」", "src": "旧五代史·卷18"}, {"a": "朱珍", "b": "庞师古", "rel": "同以中涓从太祖起兵", "year": 880, "note": "珍与师古、许唐、李晖、丁会、氏叔琮、邓季筠、王武等八十余人以中涓从，摧坚陷阵所向荡决", "src": "旧五代史·卷19"}, {"a": "朱珍", "b": "氏叔琮", "rel": "同列中涓八十余人", "year": 880, "note": "叔琮初隶庞师古为伍长，与朱珍等同从太祖", "src": "旧五代史·卷19"}, {"a": "王重师", "b": "刘捍", "rel": "为捍所构，太祖疑之", "year": 908, "note": "开平中为刘捍所构，太祖深疑之，然未有以发其事", "src": "旧五代史·卷19"}, {"a": "氏叔琮", "b": "朱友宁", "rel": "受命节制其军", "year": 902, "note": "太祖遣朱友宁将兵数万赴应，悉委叔琮节制", "src": "旧五代史·卷19"}, {"a": "胡规", "b": "葛从周", "rel": "佐其伐镇定", "year": 898, "note": "胡规佐葛从周伐镇、定，从张存敬收晋、绛，皆有功", "src": "旧五代史·卷19"}, {"a": "张文靖", "b": "葛从周", "rel": "佐其统大军御晋", "year": 899, "note": "文靖佐葛从周统大军御之，至沙河败晋军五千余骑，擒蕃将百余人", "src": "旧五代史·卷19"}, {"a": "葛从周", "b": "霍存", "rel": "同自巢军来降", "year": 884, "note": "王满渡太祖大破巢军，从周与霍存、张归霸昆弟相率来降", "src": "旧五代史·卷16"}, {"a": "葛从周", "b": "张归霸", "rel": "同自巢军来降", "year": 884, "note": "归霸昆仲与葛从周、李谠等相率来降，寻补宣武军剧职", "src": "旧五代史·卷16"}, {"a": "张归霸", "b": "张归厚", "rel": "兄弟同降", "year": 884, "note": "归厚与兄归霸自巢军来降；张归霸女为梁末帝德妃", "src": "旧五代史·卷16"}, {"a": "葛从周", "b": "贺德伦", "rel": "同率五百骑死战馆陶门", "year": 898, "note": "从周与贺德伦率五百骑出战，德伦命阖门曰「前有敌，不可返顾」，大败燕人", "src": "旧五代史·卷16"}, {"a": "葛从周", "b": "蒋元晖", "rel": "都监与主将之争", "year": 899, "note": "蒋元晖谓当纵燕军入壁，从周对曰「兵在机，机在上将，非督护所言也」", "src": "旧五代史·卷16"}, {"a": "牛存节", "b": "张全义", "rel": "率军赴河阳解其围", "year": 888, "note": "李罕之以并军围张宗奭于河阳，太祖遣存节率军赴之（张宗奭即张全义）", "src": "旧五代史·卷22"}, {"a": "康怀英", "b": "葛从周", "rel": "同领兵渡淮", "year": 899, "note": "其年冬与康怀英渡淮入寿春之境，下安丰霍丘至光州而还", "src": "旧五代史·卷16"}, {"a": "徐温", "b": "严可求", "rel": "谋主，军旅问可求", "year": 905, "note": "温用其客严可求谋，教行密阳为目疾，事成迁右衙指挥使；行密疾，温与可求入问疾取召符速遣渥", "src": "新五代史·卷61"}, {"a": "徐温", "b": "骆知祥", "rel": "国用问知祥，吴人称严骆", "year": 910, "note": "温客尤见信者惟骆知祥严可求，可求善筹划知祥长于财利，温以军旅问可求国用问知祥", "src": "新五代史·卷61"}, {"a": "徐温", "b": "杨渥", "rel": "私嘱勿应非温使者之召", "year": 905, "note": "温私谓渥曰「若它日召子，非温使者慎无应命」，渥涕泣谢温而去", "src": "新五代史·卷61"}, {"a": "杨渥", "b": "周隐", "rel": "杀之", "year": 905, "note": "行密卒渥嗣立，召周隐骂曰「汝欲卖吾国者」，遂杀之", "src": "新五代史·卷61"}, {"a": "周隐", "b": "刘威", "rel": "荐其代主军政", "year": 905, "note": "隐虑渥幼弱不任事，劝行密用旧将有威望者代主军政，乃荐大将刘威", "src": "新五代史·卷61"}, {"a": "徐温", "b": "杨隆演", "rel": "所立之吴王", "year": 908, "note": "十六年温请隆演即皇帝位不许，又请即吴王位乃许，遂建国改元，拜温大丞相", "src": "新五代史·卷61"}, {"a": "徐温", "b": "杨溥", "rel": "越次立之，又请其称帝", "year": 920, "note": "隆演卒，温越次立其弟溥；顺义七年温又请溥即皇帝位，溥未许而温病卒", "src": "新五代史·卷61"}, {"a": "李昪", "b": "徐温", "rel": "养父子", "year": 908, "note": "徐知诰为温养子，温以军国托之；后复姓李代吴", "src": "新五代史·卷62"}, {"a": "李昪", "b": "杨溥", "rel": "受其禅代吴", "year": 937, "note": "天祚三年溥禅位于徐知诰，吴亡；昪迁杨氏子孙于海陵永宁宫严兵守之", "src": "新五代史·卷61—62"}, {"a": "杨行密", "b": "刘威", "rel": "三十六英雄之首从", "year": 890, "note": "行密所与起事刘威、陶雅之徒号三十六英雄", "src": "新五代史·卷61"}, {"a": "王建", "b": "王衍", "rel": "父子", "year": 918, "note": "建卒衍嗣立，荒纵不亲政务，925 年降后唐", "src": "新五代史·卷63"}, {"a": "孟知祥", "b": "郭崇韬", "rel": "荐以自代，崇韬德之", "year": 918, "note": "前此为中门使者多以罪诛，知祥惧求佗职，荐郭崇韬自代，崇韬德之", "src": "新五代史·卷64"}, {"a": "孟知祥", "b": "李克让", "rel": "岳父（妻其女）", "year": 915, "note": "晋王以其弟克让女妻之，以为左教练使", "src": "新五代史·卷64"}, {"a": "刘隐", "b": "刘龑", "rel": "兄弟相嗣", "year": 911, "note": "父谦三子隐台岩；隐卒龑嗣，即帝位追尊隐襄皇帝", "src": "新五代史·卷65"}, {"a": "马殷", "b": "刘龑", "rel": "争容桂", "year": 910, "note": "马殷争容桂，殷取桂管虏士政；龑取容管逐巨昭，又取邕管", "src": "新五代史·卷65"}, {"a": "钱镠", "b": "董昌", "rel": "旧主，后讨平之", "year": 896, "note": "镠以骁勇事昌为石镜都知兵马使，昌僭号镠讨平之兼有两浙", "src": "新五代史·卷67"}, {"a": "王审知", "b": "王潮", "rel": "兄弟，潮卒代领", "year": 893, "note": "兄潮为县史，绪闻潮兄弟材勇召置军中；潮卒审知代领", "src": "新五代史·卷68"}, {"a": "高季兴", "b": "高从诲", "rel": "父子", "year": 928, "note": "季兴死其子从诲请命", "src": "新五代史·卷69"}, {"a": "刘旻", "b": "刘知远", "rel": "族兄弟（汉高祖母弟）", "year": 947, "note": "高祖事晋为河东节度使以旻为都指挥使；高祖即帝位以为太原尹北京留守", "src": "新五代史·卷70"}, {"a": "耶律阿保机", "b": "耶律德光", "rel": "父子嗣位", "year": 926, "note": "阿保机卒葬木叶山，德光立改元天显", "src": "新五代史·卷72"}, {"a": "耶律阿保机", "b": "耶律突欲", "rel": "父子（东丹王）", "year": 926, "note": "灭渤海以突欲为东丹王；突欲让位于德光", "src": "新五代史·卷72"}, {"a": "耶律德光", "b": "述律后", "rel": "母子，国事必告", "year": 926, "note": "德光事其母甚谨，常侍立其侧，国事必告而后行；母召胡巫问吉凶", "src": "新五代史·卷72"}, {"a": "述律后", "b": "耶律李胡", "rel": "母子，欲立之", "year": 947, "note": "述律后爱李胡欲立，兀欲自立，战而胜之", "src": "新五代史·卷72"}, {"a": "耶律突欲", "b": "耶律兀欲", "rel": "父子", "year": 947, "note": "兀欲为突欲之子，德光卒后自立于镇阳", "src": "新五代史·卷72"}, {"a": "耶律德光", "b": "石敬瑭", "rel": "援立之为晋帝", "year": 936, "note": "敬瑭遣使求救，德光白其母曰「吾尝梦石郎召我」，乃许；灭唐立晋", "src": "新五代史·卷72"}, {"a": "耶律德光", "b": "王都", "rel": "遣兵救之", "year": 928, "note": "定州王都以蜡丸书走契丹求援，德光遣秃馁荝剌以骑五千救都，败于曲阳", "src": "新五代史·卷72"}, {"a": "秃馁", "b": "王晏球", "rel": "曲阳之败", "year": 928, "note": "都及秃馁击晏球于曲阳，为晏球所败", "src": "新五代史·卷72"}, {"a": "白承福", "b": "安重荣", "rel": "附之以归晋", "year": 940, "note": "吐浑白承福为契丹所迫，附镇州安重荣以归晋，重荣因请与契丹绝好", "src": "新五代史·卷74"}]